ted="false" bounds="[55,892][1025,2060]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="app.buddy.assistant" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[55,892][1025,2060]"><node index="0" text="How Buddy uses accessibility" resource-id="" class="android.widget.TextView" package="app.buddy.assistant" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[55,892][1025,957]" /><node index="1" text="Buddy uses Android's accessibility service to do what you ask in other apps: it reads what's on the screen and taps, types and scrolls for you. It also shows the floating bubble." resource-id="" class="android.widget.TextView" package="app.buddy.assistant" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[55,957][1025,1180]" /><node index="2" text="While a task runs, the screen content, which can include personal information such as messages, names or addresses, is sent to the AI service of the agent you choose (Anthropic for Claude Code, OpenAI for Codex, Google for Antigravity, xAI for Grok, or your OpenCode model's provider), only to carry out your request." resource-id="" class="android.widget.TextView" package="app.buddy.assistant" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[55,1180][1025,1503]" /><node index="3" text="Buddy has no servers of its own. It doesn't collect, sell or share this data, and doesn't use it for ads." resource-id="" class="android.widget.TextView" package="app.buddy.assistant" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[55,1503][1025,1626]" /><node index="4" text="Before anything that sends, posts, buys or deletes, Buddy asks for your OK. You can turn the service off anytime in Android's accessibility settings." resource-id="" class="android.widget.TextView" package="app.buddy.assistant" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[55,1626][1025,1799]" /><node index="5" text="Privacy policy" resource-id="" class="android.widget.TextView" package="app.buddy.assistant" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[55,1799][1025,1878]" /><node index="6" text="" resource-id="" class="android.widget.LinearLayout" package="app.buddy.assistant" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[55,1878][1025,2060]"><node index="0" text="No thanks" resource-id="" class="android.widget.Button" package="app.buddy.assistant" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[55,1928][526,2060]" /><node index="1" text="Agree and continue" resource-id="" class="android.widget.Button" package="app.buddy.assistant" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" 