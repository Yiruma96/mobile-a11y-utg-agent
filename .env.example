# Copy to .env or export in your shell. Only ADB + an OpenAI-compatible LLM API are required!
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# Optional: override if `adb` is not already in PATH
# ADB_PATH=adb
# Optional: for HarmonyOS real device control via hdc
# HDC_PATH=hdc
