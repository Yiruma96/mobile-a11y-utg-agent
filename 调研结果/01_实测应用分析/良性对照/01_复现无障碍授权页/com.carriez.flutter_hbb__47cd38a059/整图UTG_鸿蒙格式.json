  "refusal_outcome_refined": "TRAPPED_ON_LURE_SCREEN",
  "app_chain_summary_zh": "该应用以 RustDesk 远程协助为入口，先引导进入“共享屏幕—输入控制”，再弹出“如何获取 Android 输入权限？”并跳转系统无障碍开启 RustDesk Input，最终触发“完全控制设备”的高危授权警告；拒绝后返回应用仍停在权限引导页，呈现 TRAPPED_ON_LURE_SCREEN。",
  "observed_lure_rhetoric_zh": [
    "英语 -> “哎呀，暂无最近会话！该规划新会话了。”（RustDesk 主页）",
    "英语 -> “服务未运行：点[启动服务]或启用[屏幕捕获]权限以启动屏幕共享服务。”（共享屏幕权限页）",
    "英语 -> “如何获取 Android 输入权限？”（共享屏幕权限页弹窗）",
    "英语 -> “当 RustDesk 屏幕共享建立后，允许其他设备使用虚拟触控控制你的手机。”（RustDesk Input 服务详情页）",
    "英语 -> “允许 RustDesk Input 完全控制你的设备吗？”（系统警告弹窗）",
    "英语 -> “完全控制适合帮助无障碍需求的 App，但不适合大多数 App。”（系统警告弹窗）",
    "英语 -> “查看并控制屏幕：可读取屏幕所有内容并悬浮显示在其他应用上。”（系统警告弹窗）",
    "英语 -> “查看并执行操作：可跟踪你与应用或硬件传感器的交互，并代表你操作应用。”（系统警告弹窗）"
  ],
  "frame_captions_zh": {
    "step_01": "RustDesk 主页，底部四标签；空会话提示意为“暂无最近会话，去新建一个”。本步点击“共享屏幕”标签，无通知、无遮罩。",
    "step_02": "共享屏幕权限页，提示服务未运行，可启动服务或开屏幕捕获。本步点击“输入控制”开关（未勾选），无通知、无遮罩。",
    "step_03": "权限页弹出“如何获取 Android 输入权限？”说明；本步点“打开系统设置”，仍未启动服务，无通知、无遮罩。",
    "step_04": "跳系统无障碍列表，“RustDesk Input”显示为“关闭”；捕获无障碍设置钩子后终止，无通知、无遮罩。",
    "post_jump_0.8s": "跳转后 0.8 秒探针，仍停留系统无障碍设置页；无新增文本、无通知，遮罩数为 0。",
    "post_jump_2.0s": "跳转后 2.0 秒探针，仍在系统无障碍设置页；无可读文本更新、无通知，遮罩数为 0。",
    "detail_1_service_detail_page": "RustDesk Input 详情页，含“使用”开关与快捷键；说明称共享后他机可用虚拟触控控制本机，无通知、无遮罩。",
    "detail_2_system_warning_dialog": "系统警告弹窗询问是否允许 RustDesk Input 完全控制设备，列屏幕/操作控制项，有允许/拒绝；本步点拒绝。",
    "refusal_2.0s": "拒绝后 2 秒返回应用权限页，仍显示服务未运行与输入控制等开关；停留诱导页，无通知、无遮罩。",
    "refusal_10.5s": "拒绝后 10.5 秒仍困在应用权限引导页，服务未运行提示与输入控制开关未消失，无通知、无遮罩，未自动退出。"
  }
