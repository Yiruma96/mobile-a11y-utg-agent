  "refusal_outcome_refined": "GRACEFUL_STAY_OR_DEGRADE",
  "app_chain_summary_zh": "应用从语言选择进入设置引导，要求无障碍服务与悬浮窗权限，并跳转系统无障碍列表；在服务详情页触发系统“完全控制”警告，点Deny后返回原引导页并保持可用，表现为拒权后优雅停留/降级。",
  "observed_lure_rhetoric_zh": [
    "英语 -> “无障碍服务让点击区覆盖状态栏，不读取或发送任何屏幕文字”（Step 2/拒权返回页）",
    "英语 -> “悬浮窗权限用于无障碍未启用时在状态栏下方绘制点击区”（Step 2/拒权返回页）",
    "英语 -> “若无障碍开关灰置，去应用信息三点菜单开启允许受限设置后再试”（Step 2/拒权返回页）",
    "英语 -> “Tapbar快捷方式可在状态栏放置小点击目标，不读取屏幕内容”（服务详情页）",
    "英语 -> 系统警告：“允许Tapbar完全控制设备？可查看并控制屏幕、代你操作应用”（系统警告弹窗，非应用自述）"
  ],
  "frame_captions_zh": {
    "step_01": "语言选择首页，列英语、葡语、俄语、中文等12种语言；英语已选中，点底部“Next”进入设置引导。",
    "step_02": "权限引导页，两卡片要求无障碍与悬浮窗；文案称仅覆盖状态栏、不读写屏幕文字；点无障碍“Turn on”跳系统设置。",
    "step_03": "系统无障碍列表，DOWNLOADED APPS下Tapbar显示Off；本步采集无障碍设置钩子与探针后自动终止，未开启开关。",
    "post_jump_0.8s": "跳转后0.8秒探针，仍停留系统无障碍列表；无弹窗、无通知横幅、遮罩数0，页面无新增文本。",
    "post_jump_2.0s": "跳转后2.0秒探针，仍在系统无障碍列表；无通知、无悬浮遮罩（overlays=0），未出现额外授权弹窗。",
    "detail_1_service_detail_page": "Tapbar服务详情页，有“Use Tapbar”开关及“Tapbar shortcut”选项；说明称只在状态栏放小点击目标、不读屏幕内容。",
    "detail_2_system_warning_dialog": "系统高危警告弹窗，称将允许Tapbar完全控制设备，可查看/控制屏幕并代操作；含Allow与Deny，本步仅检查未点允许。",
    "refusal_2.0s": "点Deny拒权后2秒返回设置引导页；无障碍与悬浮窗仍未开启，页面保留Skip for now，未见崩溃或强制跳转。",
    "refusal_10.5s": "拒权后10.5秒仍停在设置引导页；权限未授予，应用保持原页可继续或跳过，表现为优雅停留/降级。"
  }
