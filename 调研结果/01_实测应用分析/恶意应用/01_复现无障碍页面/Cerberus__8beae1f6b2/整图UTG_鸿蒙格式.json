  "app_chain_summary_zh": "该应用以伪装成“Android 更新”的土耳其语页面诱导用户开启无障碍服务，并跳转系统无障碍列表、服务详情和高风险授权警告；用户拒绝后反复重弹诱导页，并穿插请求忽略电池优化以维持后台运行。",
  "observed_lure_rhetoric_zh": [
    "土耳其语 -> “Android 更新”：伪装成系统更新组件（step_01/refusal_2.0s/refusal_10.5s）",
    "土耳其语 -> “下一屏需授予无障碍权限：1.点击继续 2.在已安装服务中点击 Android 更新”：借更新名义诱导开启无障碍（step_01/refusal_2.0s/refusal_10.5s）",
    "土耳其语 -> “继续”：诱导进入授权流程的按钮（step_01/refusal_2.0s/refusal_10.5s）",
    "英语 -> “使用 ANDROID GUNCELLEME”：系统无障碍服务启用项（detail_1_service_detail_page）",
    "英语 -> “允许 ANDROID GUNCELLEME 完全控制你的设备？”：高风险无障碍授权警告（detail_2_system_warning_dialog）",
    "英语 -> “让应用始终在后台运行？”：请求忽略电池优化以保活（refusal_5.5s）"
  ],
  "frame_captions_zh": {
    "step_01": "应用内土耳其语诱导页，伪装“Android 更新”，要求下一屏开启无障碍并点“继续”；本步点击该按钮。",
    "step_02": "跳转系统无障碍列表，下载应用区见“ANDROID GUNCELLEME”状态关闭；命中无障碍设置钩子后终止，无通知/遮罩。",
    "post_jump_0.8s": "跳转后0.8秒探针，仍停留系统无障碍列表页，无可见文本、无通知横幅、无遮罩，仅等待观察。",
    "post_jump_2.0s": "跳转后2.0秒探针，页面仍为系统无障碍设置，无可见文本、无通知与遮罩，未发生进一步跳转。",
    "detail_1_service_detail_page": "进入服务详情页，标题为“ANDROID GUNCELLEME”，含启用开关与快捷方式设置，说明为“未提供描述”；仅检查未授权。",
    "detail_2_system_warning_dialog": "系统无障碍高风险警告弹窗，询问是否允许“ANDROID GUNCELLEME”完全控制设备，列出读屏与代操作能力；本步未点允许。",
    "refusal_2.0s": "拒绝后2秒被拉回应用同一土耳其语诱导页，仍要求开启无障碍并点“继续”，形成拒权后循环重弹。",
    "refusal_5.5s": "拒绝后5.5秒弹出系统电池优化页，询问是否让应用始终后台运行，含“拒绝/允许”；随后又被拉回诱导页。",
    "refusal_10.5s": "拒绝后10.5秒再次回到应用土耳其语无障碍诱导页，继续催促点“继续”，显示拒权后反复重试诱导。"
  }
