  "refusal_outcome_refined": "GRACEFUL_STAY_OR_DEGRADE",
  "app_chain_summary_zh": "该应用 ru.calendar.pen 先以俄文常驻通知冒充“系统进程”，谎称“系统运行异常，需为系统进程开启使用情况访问权限”，把用户引到系统无障碍设置页，并尝试为其伪装服务开启无障碍权限；系统弹出可读屏、可代替用户操作的全权警告后，用户点击 Deny 拒绝授权，应用没有崩溃，也没有再次弹窗，而是静默退回桌面，仅保留通知横幅，等待后续诱导，表现为保活降级。",
  "observed_lure_rhetoric_zh": [
    "俄语 -> 『系统运行不正常，您需要为“系统进程”开启使用情况（统计）访问权限』（无障碍设置列表页、服务详情页常驻通知横幅，反复出现）",
    "俄语 -> 服务名『Систeмный прoцecc』意为“系统进程”，冒充系统组件以降低戒心（无障碍列表页与服务详情页条目）",
    "英语 -> 『未提供任何描述』（No description provided.），伪装服务缺少说明，与真实系统应用不符（服务详情页）"
  ],
  "frame_captions_zh": {
    "step_01": "无障碍设置列表页：DOWNLOADED APPS 下出现俄文『系统进程』伪装服务且状态为 Off，通知横幅同步诱导开启统计权限；本步捕获无障碍钩子后自动终止。",
    "post_jump_0.8s": "跳转后 0.8 秒仍停在无障碍设置页，界面文本为空（已被清空），俄文“系统运行异常需开权限”通知横幅持续挂着，无遮罩层。",
    "post_jump_2.0s": "跳转后 2.0 秒同前：无障碍设置页无新文本、无遮罩，伪系统通知横幅仍在，说明诱导依赖通知而非界面覆盖。",
    "detail_1_service_detail_page": "伪装服务的无障碍详情页：标题为俄文『系统进程』，Use 开关未启用，选项仅有快捷键与音量键，描述为“未提供任何描述”，显然并非系统组件。",
    "detail_2_system_warning_dialog": "系统全权控制警告弹窗：提示该服务可读屏、可覆盖其他应用并代替用户操作；人工检视后选择 Deny 拒绝，是关键授权拦截点。",
    "refusal_2.0s": "拒权后 2 秒已回到 Nexus 桌面，应用没有二次强扰弹窗，仅保留俄文伪系统通知横幅，表现为静默保活降级。",
    "refusal_10.5s": "拒权后 10.5 秒仍停留在桌面，无二次弹窗与遮罩，俄文伪『系统进程』通知横幅常驻，疑似持久通知等待再次诱导。"
  }
