able="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2148]"><node index="0" text="" resource-id="" class="android.widget.ScrollView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,83][1080,2148]"><node index="0" text="" resource-id="" class="android.view.View" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[66,83][1014,1851]"><node index="0" text="During the COVID-19 pandemic, I started spending almost all day on my computer or phone. Life outside felt complicated. Gaming or scrolling for hours felt easier and safer than socializing. Looking back, I think I was trying to escape real life." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,83][964,255]" /><node index="1" text="" resource-id="" class="android.view.View" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,288][964,653]"><node index="0" text="What I noticed" resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[207,321][441,365]" /><node index="1" text="I realized that short-content habits were taking more time and attention than I wanted.&#10;&#10;I wanted a clearer boundary that would help me get back to my studies and my goals." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,376][931,620]" /></node><node index="2" text="Why did I build this app under Resolve Community?" resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,686][964,789]" /><node index="3" text="Even when I was busy with something else, I'd find myself opening short videos without thinking. I built AwayDoomscrollin' under Resolve Community to create a clear boundary that holds even on tired days. I use it myself, and it keeps improving through testing and feedback from people who use it." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,806][964,1171]" /><node index="4" text="" resource-id="" class="android.view.View" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,1204][964,1565]"><node index="0" text="Why short-content feeds never end" resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[207,1237][783,1284]" /><node index="1" text="• Feeds automatically load the next item.&#10;• Watch time and interactions can be used to personalize what appears next.&#10;• Because there is no natural stopping point, a short visit can last longer than intended." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1301][931,1532]" /></node><node index="5" text="AwayDoomscrollin' was created to make room for study, work and intentional time. Protection is a tool; you can review its scope and choose the apps that fit your needs." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,1604][964,1801]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[644,1905][1017,2039]"><node index="0" text="Start setup →" resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable=