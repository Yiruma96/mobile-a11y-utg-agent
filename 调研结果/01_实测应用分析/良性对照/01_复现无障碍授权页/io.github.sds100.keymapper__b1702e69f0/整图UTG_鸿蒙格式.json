  "app_chain_summary_zh": "应用先展示4.7.1更新日志，随后在主界面以“按键映射必须依赖无障碍服务”反复提示，并引导点击Fix/Enable跳转系统无障碍设置；最终在系统“完全控制设备”高危警告处被拒权并返回桌面。全程仅请求无障碍权限，拒权后通知保留、应用未崩溃，呈优雅保留/降级，未见强制循环、遮罩或自动授权。",
  "observed_lure_rhetoric_zh": [
    "英文 -> 通知横幅提示“无障碍服务已禁用，点击可启动无障碍服务”（全局通知）",
    "英文 -> “必须开启无障碍服务，否则按键映射无法工作”（主界面警告）",
    "英文 -> “建议关闭电池优化”（主界面提示）",
    "英文 -> “必须启用无障碍服务；你可能需要允许受限设置，点击阅读说明”（说明弹窗）",
    "英文 -> “Key Mapper需要无障碍服务来检测并改变你在应用外的按键行为；启用后才能创建触发和测试动作”（说明弹窗/服务详情）",
    "英文 -> “允许Key Mapper完全控制你的设备？”（系统警告弹窗）",
    "英文 -> “完全控制适合帮助无障碍需求的应用，但不适合大多数应用”（系统警告弹窗）",
    "英文 -> “可查看并控制屏幕，读取屏幕全部内容并悬浮显示在其他应用上”（系统警告弹窗）",
    "英文 -> “可查看并执行动作，追踪你与应用或硬件传感器的交互，并代表你操作应用”（系统警告弹窗）"
  ],
  "frame_captions_zh": {
    "step_01": "主界面弹4.7.1“What's New”更新日志，介绍变量与命名等；通知提示无障碍未启用。点击OK关闭弹窗，无遮罩。",
    "step_02": "主界面警告无障碍未开启则映射不生效，旁有Fix；空状态引导创建映射。点击Fix开说明弹窗，通知仍提示未启用。",
    "step_03": "弹窗称必须启用无障碍服务，称可检测并改变应用外按键、创建触发与测试；提示可能需解除受限设置。点Enable跳系统设置。",
    "step_04": "系统无障碍列表页，“已下载应用”中Key Mapper为Off，另有屏幕阅读器与显示设置。捕获设置钩子后自动终止，未点击开启。",
    "post_jump_0.8s": "跳转后0.8秒探针，仍停留在无障碍设置页；页面未抓到文本，遮罩为0，Key Mapper未启用通知持续显示。",
    "post_jump_2.0s": "跳转后2.0秒探针，仍在无障碍设置页；无文本、无遮罩，Key Mapper未启用通知持续存在，未见自动授权。",
    "detail_1_service_detail_page": "Key Mapper无障碍服务详情页，有Use Key Mapper开关、快捷键选项为Off，并重复说明需无障碍检测应用外按键。仅检查详情，未开启。",
    "detail_2_system_warning_dialog": "系统弹窗问是否允许Key Mapper完全控制设备，列明可读全屏、悬浮显示、追踪交互并代操作；含Allow/Deny，仅检查未点。",
    "refusal_2.0s": "拒权返回后2秒回到桌面启动器，显示应用列表、日期天气与图标；Key Mapper未启用通知仍在，未崩溃，呈保留/降级状态。",
    "refusal_10.5s": "拒权返回后10.5秒仍在桌面启动器，无应用弹窗或遮罩；Key Mapper未启用通知持续存在，应用未崩溃，保持降级。"
  }
