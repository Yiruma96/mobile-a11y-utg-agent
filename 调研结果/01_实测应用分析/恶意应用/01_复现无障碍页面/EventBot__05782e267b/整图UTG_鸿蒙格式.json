  "refusal_outcome_refined": "RELAUNCHED_LURE_DIALOG",
  "app_chain_summary_zh": "该应用先请求文件媒体与短信权限并常驻桌面，循环弹出假“Flash Update”故障浮层诱导开启无障碍；进入系统授权页后若拒绝，返回桌面仍反复重弹同一诱骗浮层。",
  "observed_lure_rhetoric_zh": [
    "English -> “选择允许 Flash Update 访问什么”，请求文件媒体与短信权限（权限审核页）",
    "English -> “Flash Update 将无法正常工作”，以故障恐吓促使用户开启（假浮层/服务详情页）",
    "English -> “1. 在设置中选择 Flash Update；2. 将其开启”，给出开启无障碍的诱导步骤（假浮层/拒权后重弹页）",
    "English -> “启用 Flash Update”，诱导点击跳转无障碍设置（假浮层/拒权后重弹页）",
    "English -> “必须启用 Flash Update 才能获得应用完整功能”，以功能不完整施压（无障碍服务详情页）",
    "English -> “允许 Flash Update 完全控制你的设备？”，系统高危授权警告（系统警告弹窗）",
    "English -> “可查看并控制屏幕/查看并执行操作”，说明无障碍可读屏、覆盖显示和代操作（系统警告弹窗）"
  ],
  "frame_captions_zh": {
    "step_01": "权限审核页：Flash Update 请求文件媒体与短信权限；点“继续”放行，无通知横幅或遮罩。",
    "step_02": "桌面启动器页：等待后台约每20秒循环弹出假“Flash Update”浮层；本步仅等待，无通知、遮罩为0。",
    "step_03": "仍在桌面等待：未出现系统通知或遮罩，预期假“Flash Update”浮层按约20秒循环再次弹出。",
    "step_04": "假“Flash Update”浮层称将无法正常工作，列出“设置选择/开启”两步，仅“启用”键无取消，点击后跳系统无障碍。",
    "step_05": "系统无障碍设置页：已下载应用中“Flash Update”为“关闭”；捕获无障碍钩子/探针后自动终止，无通知或遮罩。",
    "post_jump_0.8s": "跳转后0.8秒探针：仍停在无障碍设置页，无UI文本、无通知横幅，遮罩计数为0。",
    "post_jump_2.0s": "跳转后2.0秒探针：仍停在无障碍设置，无通知或浮层，遮罩计数为0，未见新动作。",
    "detail_1_service_detail_page": "无障碍服务详情页：开关“Use Flash Update”未启用，提示必须开启才具完整功能；含音量键快捷键，仅检查未操作。",
    "detail_2_system_warning_dialog": "系统高危授权弹窗：称允许“Flash Update”完全控制设备，可读屏并代操作；有“允许/拒绝”，本步仅检查未点。",
    "refusal_2.0s": "点“拒绝”返回桌面后2秒，假“Flash Update”启用无障碍诱导浮层再次自动弹出；无通知横幅，遮罩为0。",
    "refusal_10.5s": "拒权返回10.5秒后，同一假“Flash Update”启用无障碍浮层仍反复重弹，显示拒权后诱骗并未停止。"
  }
