  "refusal_outcome_refined": "TRAPPED_ON_LURE_SCREEN",
  "app_chain_summary_zh": "该应用从 EULA 入口以“提升无障碍与数字福祉、仅本地统计、不读取内容”等话术取得信任，随后引导进入系统无障碍列表、服务详情和“完全控制设备”警告。用户拒绝授权后，应用反复回到“无障碍服务已禁用”主页，只保留“打开无障碍设置”诱导按钮，缺少跳过或退出路径，形成 TRAPPED_ON_LURE_SCREEN。",
  "observed_lure_rhetoric_zh": [
    "英文 -> 自动化竖屏视频滚动以提升无障碍与数字福祉（入口 EULA）",
    "英文 -> 长时间观看竖屏内容可能影响福祉，建议设置健康时限（入口 EULA）",
    "英文 -> 使用统计仅保存在本机、不传服务器、不共享、不访问观看内容；未来云同步也需明确同意（入口 EULA）",
    "英文 -> AutoScroller 仅执行滚动手势，不读取、存储或传输你的内容（服务详情页）",
    "英文 -> 允许 AutoScroller 完全控制设备；该权限适合无障碍需求，但不适合多数应用（系统警告弹窗）",
    "英文 -> 可查看并控制屏幕、读取屏幕全部内容并覆盖显示在其他应用上（系统警告弹窗）",
    "英文 -> 可追踪你与应用或硬件传感器的交互，并代表你操作应用（系统警告弹窗）",
    "英文 -> 无障碍服务已禁用，必须点击按钮找到 AutoScroller 并开启开关才能使用（拒权返回页）"
  ],
  "frame_captions_zh": {
    "step_01": "入口 EULA 首页：以自动化滚动、无障碍与数字福祉、本地统计和隐私承诺安抚用户；点击“Accept and continue”继续。",
    "step_02": "系统无障碍列表：显示“AutoScroller 关闭/自动滚动竖屏视频”条目，作为授权入口；捕获无障碍钩子后自动终止。",
    "post_jump_0.8s": "授权列表跳后0.8秒探针：仍停留无障碍设置页，UI文本为空、遮罩0，未见弹窗或通知横幅。",
    "post_jump_2.0s": "跳后2.0秒探针：仍在无障碍设置页，界面无文本、遮罩0，无额外授权提示或系统弹窗。",
    "detail_1_service_detail_page": "服务详情页：说明 AutoScroller 用于 Reels/TikTok/Shorts，仅执行滚动手势、不读取存储传输内容；含使用开关与快捷方式。",
    "detail_2_system_warning_dialog": "系统“完全控制”警告：列明可查看控制屏幕、读取全部内容、覆盖显示及追踪交互；本步查看警告，拒绝后回应用。",
    "refusal_2.0s": "拒权返回+2秒：应用主页显示“无障碍服务已禁用”，要求去设置开启 AutoScroller；无跳过或退出，停留于诱导页。",
    "refusal_10.5s": "拒权返回+10.5秒：仍卡在“无障碍已禁用”主页，重复“打开无障碍设置”按钮和预览计数；无逃逸路径。"
  }
