  "app_chain_summary_zh": "该应用以 WebView 假借为 Chrome 开启无障碍服务，逐步引导用户进入系统无障碍设置并开启 Chrome 服务；用户拒绝返回后仍重复弹出同一诱导对话框，具有明显社工诱导与权限滥用特征。",
  "observed_lure_rhetoric_zh": [
    "Enable Accessibility Service • Find 'Chrome' Set switch ON Open Settings（英文） -> 启用无障碍服务：找到“Chrome”并打开开关，点“打开设置”（WebView 诱导页/拒权后重弹页）",
    "Erişebilirlik Hizmetini Etkinleştirin.（土耳其语） -> 启用无障碍服务（Chrome 服务详情页）",
    "Servisi etkinleştirin / Chrome（土耳其语通知） -> 启用服务 / Chrome（贯穿各页的通知横幅）"
  ],
  "frame_captions_zh": {
    "step_01": "应用内 WebView 显示“打开设置”诱导提示，UI 文本未抓取；点击坐标触发跳转，通知栏持续显示土耳其语“启用服务/Chrome”。",
    "step_02": "WebView 英文诱导页明确要求启用无障碍服务：找到“Chrome”并打开开关；本步点击“Open Settings”打开系统设置，通知横幅仍在。",
    "step_03": "进入系统无障碍设置列表，可见“Chrome”状态为 Off；应用通知仍显示“启用服务”，抓取到设置 Hook 与探针后自动终止。",
    "post_jump_0.8s": "跳转后 0.8 秒探针：仍停留在系统无障碍设置页，无遮罩、无新增文案；通知栏继续显示“启用服务/Chrome”。",
    "post_jump_2.0s": "跳转后 2.0 秒探针：页面仍为系统无障碍设置，遮罩数为 0；通知横幅持续存在，未见进一步界面变化。",
    "detail_1_service_detail_page": "进入 Chrome 无障碍服务详情页，含土耳其语“启用无障碍服务”及“使用 Chrome”、快捷键/按住音量键选项；本步仅检查详情未授权。",
    "detail_2_system_warning_dialog": "标题称系统警告弹窗，但实际仍显示应用内英文诱导页：启用无障碍、找到 Chrome、打开开关；遮罩 0，未见系统取消键。",
    "refusal_2.0s": "拒绝/返回后 2 秒，应用再次拉起同一英文无障碍诱导对话框（RELAUNCHED_LURE_DIALOG）；通知横幅与“Open Settings”入口仍保留。",
    "refusal_10.5s": "拒绝/返回后 10.5 秒，诱导对话框仍反复重弹，页面内容未变；说明拒绝授权后应用持续施压引导开启 Chrome 无障碍服务。"
  }
