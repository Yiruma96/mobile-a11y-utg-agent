  "refusal_outcome_refined": "TRAPPED_ON_LURE_SCREEN",
  "app_chain_summary_zh": "GKD 启动后依次弹出「使用须知」与「无障碍说明」两个同意弹窗，再引导用户在主页开启无障碍、写入安全设置与触摸优化特权，并跳转系统无障碍列表；用户在被拒后（系统高危警告选 Deny）返回应用，仍被卡在要求授权的主页，未能进入任何正常功能，判定为 TRAPPED_ON_LURE_SCREEN。",
  "observed_lure_rhetoric_zh": [
    "英文 -> 「使用须知：欢迎使用 GKD！继续前请阅读并接受用户协议与隐私政策，请仔细阅读。」（Step1 使用须知弹窗，仅“不同意/同意”两键）",
    "英文 -> 「关于无障碍：GKD 使用系统无障碍 API 读取屏幕信息，并依据你的订阅规则执行自动化操作。」（Step2 无障碍说明弹窗）",
    "英文 -> 「忽略电池优化：Android 可能在后臺冻结 GKD 并延迟规则触发」——以功能失效为由施压（Step3 主页提示）",
    "英文 -> 「自动启动：永久授予写入安全设置权限，允许应用开启和关闭无障碍」——以便利换取常驻高权限（Step4）",
    "英文 -> 「启用 GKD 无障碍：将打开系统无障碍设置，依次为 1 在服务列表找到 GKD 2 打开并确认系统提示 3 返回 GKD」（Step5 引导弹窗）",
    "英文 -> 「允许 GKD 完全控制你的设备？它可读取屏幕全部内容、跟踪你的交互并代替你操作应用。」（系统高危授权警告）",
    "英文 -> 「GKD 伴生服务（请勿手动启用）」「GKD 触摸优化（请勿手动启用）」（系统无障碍列表项，暗示另有隐藏开关）"
  ],
  "frame_captions_zh": {
    "step_01": "启动后首个「使用须知」弹窗，英文要求阅读并同意用户协议与隐私政策，仅「不同意/同意」；本步点击「同意」继续。",
    "step_02": "第二个「关于无障碍」弹窗，说明 GKD 将用系统无障碍 API 读屏并按订阅规则自动操作；本步点击「同意」进入主页。",
    "step_03": "GKD 主页：服务状态显示「无障碍未授权」，并有忽略电池优化提示与工作模式、历史等入口；本步点击「工作模式」行。",
    "step_04": "无障碍设置页：手动启动需单次授权，自动启动要求永久写入安全设置，触摸优化需特权服务；本步点击「启用无障碍」。",
    "step_05": "应用内引导弹窗称即将打开系统无障碍设置，并列三步操作，只有「取消/前往」；本步点「前往」跳转系统设置。",
    "step_06": "跳至系统无障碍列表，GKD 显示「关闭」，另有两项标注「请勿手动启用」的伴生服务；采到无障碍设置钩子后自动终止。",
    "post_jump_0.8s": "跳转后 0.8 秒探针：仍停在系统无障碍设置列表，无弹窗、无遮罩、无通知横幅，界面无任何变化。",
    "post_jump_2.0s": "跳转后 2.0 秒探针：页面依旧为系统无障碍列表，未出现遮罩或通知，等待期间也未见自动开启开关的动作。",
    "detail_1_service_detail_page": "GKD 服务详情页：「使用 GKD」总开关为关闭，选项含 GKD 快捷方式；下方英文说明称可基于高级选择器与订阅规则自定义点击屏幕。",
    "detail_2_system_warning_dialog": "系统高危授权警告：询问是否允许 GKD 完全控制设备，列明可读取全部屏幕内容、跟踪交互并代为操作；本步查看后选择拒绝。",
    "refusal_2.0s": "拒权返回应用 2 秒：回到无障碍设置页，「启用无障碍」入口仍醒目存在，授权状态未变，仍被判定停留在诱导页。",
    "refusal_10.5s": "拒权后 10.5 秒：界面与 2 秒时完全一致，应用未放行也未给替代路径，持续卡在要求授权的诱导界面（TRAPPED_ON_LURE_SCREEN）。"
  }
