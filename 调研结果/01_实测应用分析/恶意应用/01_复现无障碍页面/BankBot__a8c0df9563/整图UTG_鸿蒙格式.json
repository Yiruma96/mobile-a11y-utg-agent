  "observed_lure_rhetoric_zh": [
    "土耳其语 -> 「Servisi etkinleştirin」（启用服务；通知标题，多页持续显示）",
    "英文 -> 「Enable Accessibility Service • Find 'Postegro' Set switch ON / Open Settings」（启用无障碍服务，找到Postegro并打开开关/打开设置；WebView诱导弹窗）",
    "土耳其语 -> 「Erişebilirlik Servisileri Etkinleştirme」（启用无障碍服务；服务详情页）",
    "英文 -> 「Allow Postegro to make and manage phone calls?」（允许Postegro拨打和管理电话；系统权限弹窗）",
    "英文 -> 「Allow Postegro to send and view SMS messages?」（允许Postegro发送和查看短信；系统权限弹窗）"
  ],
  "frame_captions_zh": {
    "step_01": "系统电话权限弹窗，英文询问是否允许Postegro拨打和管理电话；点击Allow授予，为后续诱导流程放行。",
    "step_02": "系统短信权限弹窗，英文询问是否允许Postegro发送和查看短信；点击Allow授予；顶部已出现土耳其语服务通知。",
    "step_03": "回到桌面，可见Postegro土耳其语通知「Servisi etkinleştirin（启用服务）」；点击横幅跳转应用，未出现遮罩。",
    "step_04": "进入Postegro空白WebView页，界面无可见文本；通知横幅仍在；点击中央区域应触发「打开设置」与无障碍诱导。",
    "step_05": "系统无障碍设置列表，下载应用中有Postegro且开关Off；顶部保留启用服务通知；采集钩子后自动终止。",
    "post_jump_0.8s": "跳转后0.8秒探针：仍停留在无障碍设置列表，无文本与遮罩；Postegro启用服务通知持续显示。",
    "post_jump_2.0s": "跳转后2.0秒探针：页面未变化，无障碍列表无遮罩；Postegro通知横幅仍驻留，未触发新弹窗。",
    "detail_1_service_detail_page": "Postegro无障碍服务详情页，含Use Postegro开关及选项；底部出现土耳其语「启用无障碍服务」提示，通知仍在。",
    "detail_2_system_warning_dialog": "Postegro内WebView诱导弹窗：英文要求启用无障碍服务，查找Postegro并打开开关，点Open Settings；无遮罩。",
    "refusal_2.0s": "拒权返回2秒后，同一「启用无障碍服务」诱导弹窗被重新拉起；通知横幅仍在，未提供取消出口。",
    "refusal_10.5s": "拒权返回10.5秒后，诱导弹窗仍反复重现；页面持续要求开启无障碍并点Open Settings，通知未消失。"
