  "refusal_outcome_refined": "TRAPPED_ON_LURE_SCREEN",
  "app_chain_summary_zh": "应用以4步引导让用户接受无障碍按钮启动器，随后跳转系统无障碍设置并弹出“完全控制设备”高危授权；点击拒绝后仍反复回到设置待办页，无跳过或退出，表现为拒权即滞留的诱导链路。",
  "observed_lure_rhetoric_zh": [
    "英文 -> “一个按钮，一个应用；启用后可在其他应用中打开所选应用或快捷方式”（Step 1 主引导页）",
    "英文 -> “无障碍披露：需在设置中开启服务，按钮才能工作”（Step 2 设置待办页）",
    "英文 -> “不受限电池：防止系统休眠该服务”（Step 2 设置待办页）",
    "英文 -> “按钮动作：尚未分配；请选择应用或应用内快捷方式供按下时打开”（Step 2 设置待办页）",
    "英文 -> “允许Accessibility Button Launcher完全控制设备？适用于无障碍需求，不适用于多数应用”（系统警告弹窗）",
    "英文 -> “查看并控制屏幕：可读取全部屏幕内容并覆盖其他应用显示”（系统警告弹窗）",
    "英文 -> “查看并执行操作：可追踪与应用的交互并代表你操作”（系统警告弹窗）",
    "英文 -> “从无障碍按钮或快捷方式启动所选应用”（服务详情页）"
  ],
  "frame_captions_zh": {
    "step_01": "应用引导第1/4步，宣称“一个按钮，一个应用”，展示无障碍按钮位于导航栏或屏幕边缘，点击“接受并继续”进入下一步。",
    "step_02": "设置待办页称还需3步，分无障碍服务、按钮打开对象、电池不限三项；点击“无障碍服务”卡片，准备跳系统设置。",
    "step_03": "跳转系统无障碍列表，见“Accessibility Button Launcher”处于关闭；探针命中无障碍设置钩子后自动终止，未执行授权。",
    "post_jump_0.8s": "跳转后0.8秒探针，仍停留在系统无障碍设置页，未发现弹窗或悬浮遮罩，等待未操作。",
    "post_jump_2.0s": "跳转后2.0秒探针，仍停留在系统无障碍设置页，未发现弹窗或悬浮遮罩，等待未操作。",
    "detail_1_service_detail_page": "应用无障碍服务详情页，选项显示快捷方式关闭；说明“通过无障碍按钮或快捷方式启动所选应用”，本步仅检查未操作。",
    "detail_2_system_warning_dialog": "系统高危授权弹窗警告“完全控制设备”，列出读取屏幕、显示悬浮窗、追踪交互并以应用代操作；提供允许/拒绝。",
    "refusal_2.0s": "点“拒绝”返回应用后仍停在“设置待办/3步剩余”页，反复要求开启无障碍服务，未提供跳过或退出，形成拒权滞留。",
    "refusal_10.5s": "拒权10.5秒后仍停留在同一设置待办页，无障碍服务项与“3步剩余”持续催促，无取消/退出路径，确认被困于诱导页。"
  }
