  "app_chain_summary_zh": "应用以“Rei dos Canais/保护系统”为名，先请求忽略电池优化，再用葡语五步防毒向导诱导开启无障碍“服务”，拒权后卡在“正在配置”诱饵页无法返回。",
  "observed_lure_rhetoric_zh": [
    "英语 -> 允许应用始终后台运行？可能增加耗电（Step 1 电池优化请求）",
    "葡萄牙语 -> 欢迎使用保护系统，需授予若干权限才能正常防护（Step 2 欢迎页）",
    "葡萄牙语 -> 第1步保护服务可检测恶意应用、自动拦截威胁、实时保护数据（Step 3/拒权页）",
    "葡萄牙语 -> 企业界面渲染与无障碍优化服务（Step 4 无障碍列表）",
    "英语 -> 允许媒体播放器完全控制设备，可查看控制屏幕并代你操作（系统警告弹窗）",
    "葡萄牙语 -> 正在配置保护服务，请稍候（拒权返回页）"
  ],
  "frame_captions_zh": {
    "step_01": "系统电池优化请求页：英文问是否允许Rei dos Canais始终后台运行并提示耗电；点击Allow，通知横幅仍为系统服务优化中。",
    "step_02": "应用五步向导欢迎页（0/5）：葡语称保护系统仅需几步完成，需授予权限；点击AVANÇAR继续，通知横幅持续。",
    "step_03": "向导第1/5步：葡语称保护服务可检测恶意应用、自动拦截威胁、实时护数据；点击ATIVAR SERVIÇO进入授权，通知横幅仍在。",
    "step_04": "Android无障碍列表：Rei dos Canais显示Off，描述为“企业界面渲染与无障碍优化服务”；采集到无障碍设置钩子后自动终止。",
    "post_jump_0.8s": "跳转后0.8秒探针：仍停留在无障碍设置页，UI文本为空、无遮罩；应用系统服务优化通知横幅仍在。",
    "post_jump_2.0s": "跳转后2.0秒探针：页面仍为无障碍设置页，未出现弹窗或遮罩；通知横幅继续显示“系统服务/优化能耗”。",
    "detail_1_service_detail_page": "无障碍服务详情页：展示“media player”及“Use media player”、音量键快捷方式等选项，说明为“未提供描述”；无遮罩。",
    "detail_2_system_warning_dialog": "系统警告弹窗：英文称允许media player完全控制设备，可查看/控制屏幕并代操作；提供Allow/Deny，本步点Deny。",
    "refusal_2.0s": "拒权返回向导+2秒：仍停第1/5步保护服务页，下方“正在配置保护服务，请稍候”；无法离开，判定困在诱饵页。",
    "refusal_10.5s": "拒权返回+10.5秒：页面与2秒时相同，第1/5步保护服务及“正在配置…请稍候”持续；仍困在诱饵页。"
  }
