ed="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,228][232,344]" /><node index="1" text="I'm one of you." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[265,233][590,296]" /><node index="2" text="A letter from Resolve Community" resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[265,296][770,339]" /><node index="3" text="Hi, I'm the independent developer behind Resolve Community and AwayDoomscrollin'." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,394][964,497]" /><node index="4" text="During the COVID-19 pandemic, I started spending almost all day on my computer or phone. Life outside felt complicated. Gaming or scrolling for hours felt easier and safer than socializing. Looking back, I think I was trying to escape real life." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,514][964,773]" /><node index="5" text="" resource-id="" class="android.view.View" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,806][964,1171]"><node index="0" text="What I noticed" resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[207,839][441,883]" /><node index="1" text="I realized that short-content habits were taking more time and attention than I wanted.&#10;&#10;I wanted a clearer boundary that would help me get back to my studies and my goals." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,894][931,1138]" /></node><node index="6" text="Why did I build this app under Resolve Community?" resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,1204][964,1307]" /><node index="7" text="Even when I was busy with something else, I'd find myself opening short videos without thinking. I built AwayDoomscrollin' under Resolve Community to create a clear boundary that holds even on tired days. I use it myself, and it keeps improving through testing and feedback from people who use it." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,1324][964,1689]" /><node index="8" text="" resource-id="" class="android.view.View" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,1722][964,2083]"><node index="0" text="Why short-content feeds never end" resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[207,1755][783,1802]" /><node index="1" text="• Feeds automatically load the next item.&#10;• Watch time and interactions can be used to personalize what appears next.&#10;• Because there is no natural stopping point, a short visit can last longer than intended." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[149,1819][931,2050]" /></node><node index="9" text="AwayDoomscrollin' was created to make room for study, work and intentional time. Protection is a tool; you can review its scope and choose the apps that fit your needs." resource-id="" class="android.widget.TextView" package="com.resolvecommunity.awaydoomscrollin" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[116,2122][964,2148]" /></node></node></node></node></node></node></node></node></hiera