  "app_chain_summary_zh": "应用启动后先被系统 Resolver 的“无应用可执行此操作”错误页卡住，多次返回、回桌面和坐标点击后，在解析器中选择 Supernova 进入引导页；跳过设置后进入极简桌面，再打开应用设置准备查找手势/锁屏项。全程未见明显诱导话术、通知横幅或遮罩，也未观察到权限索取。",
  "observed_lure_rhetoric_zh": [
    "Welcome to Supernova -> 欢迎来到 Supernova（Step 6 引导页标题）",
    "Infinitely customisable homescreen -> 无限可定制的主屏（Step 6 引导页说明）",
    "Design my homescreen -> 设计我的主屏（Step 6 引导页按钮）",
    "Restore backup -> 恢复备份（Step 6 引导页按钮）",
    "Skip setup -> 跳过设置（Step 6 引导页按钮）"
  ],
  "frame_captions_zh": {
    "step_01": "系统解析器错误页，仅显示“无应用可执行此操作”；无通知与遮罩，本步执行打开操作后仍停留该错误页。",
    "step_02": "仍是系统解析器错误页，文案同为“无应用可执行此操作”；本步按返回键尝试关闭卡住的弹窗，未见权限请求。",
    "step_03": "系统解析器错误页持续存在，显示“无应用可执行此操作”；本步按 Home 键退出以解除卡顿，页面无通知横幅。",
    "step_04": "系统解析器错误页，仍提示“无应用可执行此操作”；本步坐标点击尝试选择默认主屏选项，界面文本尚未更新。",
    "step_05": "系统主屏选择弹窗，列出“将 Pixel Launcher 设为主屏/仅一次/始终/使用其他应用/Supernova”；本步点选 Supernova 返回目标应用。",
    "step_06": "Supernova 引导页，含“欢迎来到 Supernova、无限可定制主屏、设计我的主屏、恢复备份、跳过设置”；本步点“跳过设置”。",
    "step_07": "进入极简桌面主页，显示 Supernova 设置图标及 Gmail、照片、电话、信息、地图、Chrome、相机等；本步点击“Supernova 设置”。",
    "step_08": "应用设置页，含“设为默认桌面、完成操作、屏幕/主屏/停靠栏/应用抽屉/文件夹/信息流”等；本步向下滑动查找手势与锁屏项。"
  }
