  "refusal_outcome_refined": "GRACEFUL_STAY_OR_DEGRADE",
  "app_chain_summary_zh": "应用入口主界面以“开源不联网、绝对安全”安抚用户，并要求开启无障碍、电池不优化、后台耗电和任务锁定；点击权限后先展示本机数据处理说明，同意即跳系统无障碍列表并进入服务详情，在系统“完全控制”警告处被拒绝后返回主界面并优雅降级停留，无通知、无遮罩、无崩溃。",
  "observed_lure_rhetoric_zh": [
    "中文 -> “开源不联网，绝对安全”，并称为保证正常工作需开启无障碍、电池不优化、允许后台耗电及锁定任务（主界面/拒权返回页）",
    "中文 -> 无障碍服务读取屏幕控件文字、描述和位置以识别并点击开屏广告“跳过”，称仅本机内存即时比对、不保存、不联网不上传（授权说明弹窗）",
    "中文 -> 添加程序跳过方法会保存所选控件文字、描述和坐标，复制窗口控件会写入系统剪贴板，可在设置查看或删除（授权说明弹窗）",
    "English -> “Allow 开屏跳过-无障碍服务 to have full control of your device?”即允许其完全控制设备，并提示可查看控制屏幕、读取所有内容及代用户操作（系统警告弹窗）"
  ],
  "frame_captions_zh": {
    "step_01": "主界面要求检查四项设置：开无障碍、电池不优化、允许后台耗电、锁定任务；本步点无障碍权限按钮，无通知无遮罩。",
    "step_02": "授权前说明弹窗，中文解释仅本机识别“跳过”按钮、不保存不联网；本步点“同意并前往设置”跳系统无障碍。",
    "step_03": "系统无障碍列表页，DOWNLOADED APPS 下见“开屏跳过-无障碍服务”为 Off；触发设置钩子后自动终止，无通知无遮罩。",
    "post_jump_0.8s": "跳转后 0.8 秒探针，仍停留在系统无障碍列表页，界面文本为空，overlays=0，无通知横幅或遮罩。",
    "post_jump_2.0s": "跳转后 2.0 秒探针，仍在系统无障碍列表页，界面文本为空，overlays=0，未见通知或悬浮层。",
    "detail_1_service_detail_page": "服务详情页，含 Use 开屏跳过-无障碍服务、OPTIONS 与 Shortcut 为 Off；说明称开源、无网络权限、不收集上传。",
    "detail_2_system_warning_dialog": "系统警告弹窗，英文提示允许后完全控制设备、查看控制屏幕并代操作，含 Allow/Deny；本步检查后选择拒绝。",
    "refusal_2.0s": "拒绝授权返回主界面 2 秒，仍显示四项设置说明与网址；应用未强制退出，状态为优雅停留或降级，无通知遮罩。",
    "refusal_10.5s": "拒绝授权返回主界面 10.5 秒，界面与之前一致，仍引导检查设置；无二次弹窗、无通知、无遮罩，保持降级停留。"
  }
