  "app_chain_summary_zh": "应用先请求电池优化白名单并以伪系统通知常驻，随后用葡语“保护系统”五步向导诱导启用无障碍服务“Privacy”；进入系统无障碍详情与高风险完全控制警告，拒绝授权后仍卡在“正在配置保护服务”的诱导页，形成 TRAPPED_ON_LURE_SCREEN。",
  "observed_lure_rhetoric_zh": [
    "英文 -> 允许应用始终在后台运行？（电池优化弹窗）",
    "英文 -> 允许 Privacy 始终后台运行可能缩短续航，可稍后在设置中更改（电池优化弹窗）",
    "葡萄牙语 -> 欢迎来到保护系统；本向导将用几步配置设备保护，需要授予权限，点击 AVANÇAR 继续（设置向导第0/5页）",
    "葡萄牙语 -> 保护服务需激活以检测恶意应用、自动拦截威胁并实时保护数据，点击 ATIVAR SERVIÇO（设置向导第1/5页）",
    "葡萄牙语 -> 企业界面渲染优化与无障碍服务（系统无障碍列表/详情描述）",
    "英文 -> 允许 Privacy 完全控制设备？完全控制适合无障碍需求应用，不适用于多数应用；可查看控制屏幕、读取所有屏幕内容并叠加显示、跟踪交互并代为操作（系统警告弹窗）",
    "葡萄牙语 -> 正在配置保护服务……请稍候（拒权返回向导页）",
    "葡萄牙语/英文 -> “系统服务”/“正在优化能耗……”（常驻通知，伪装系统优化）"
  ],
  "frame_captions_zh": {
    "step_01": "系统电池优化弹窗，英文诱导允许Privacy始终后台运行并称可能耗电；点Allow授权，通知栏伪装系统优化。",
    "step_02": "设置向导第0/5页，葡语欢迎来到保护系统，称需授予权限配置防护；点AVANÇAR进入下一步，通知栏仍有伪装。",
    "step_03": "向导第1/5页，葡语称保护服务需激活以检测恶意应用、拦截威胁并实时护数据；点ATIVAR SERVIÇO跳转无障碍。",
    "step_04": "跳至系统无障碍列表，已下载应用Privacy显示关闭，描述为企业界面渲染优化与无障碍服务；采集钩子后终止。",
    "post_jump_0.8s": "跳转后0.8秒探针，仍在无障碍列表且无可见文本；遮罩数为0，仅见伪装系统优化通知，等待观察。",
    "post_jump_2.0s": "跳转后2.0秒探针，无障碍列表无新增文本、无遮罩；伪装系统服务通知持续，页面未自动跳转。",
    "detail_1_service_detail_page": "Privacy服务详情页，显示Use Privacy开关关闭及Privacy shortcut选项；描述仍为企业渲染优化与无障碍，供检查。",
    "detail_2_system_warning_dialog": "系统高风险警告：允许Privacy完全控制设备？称可读取屏幕、叠加显示并代操作；含Allow/Deny，本步检查未点。",
    "refusal_2.0s": "点Deny/返回后2秒回到向导第1/5页，仍显示激活服务与“正在配置，请稍候”；无法退出，判定困在诱导页。",
    "refusal_10.5s": "拒权后10.5秒仍停在向导第1/5页，激活按钮与“正在配置保护服务，请稍候”不变；持续困在诱导页。"
  }
