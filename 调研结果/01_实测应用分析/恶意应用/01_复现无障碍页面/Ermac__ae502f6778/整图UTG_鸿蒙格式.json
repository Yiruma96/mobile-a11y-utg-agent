  "app_chain_summary_zh": "应用从系统无障碍设置入口引导开启 HookAPPService，并在服务详情以“关闭再开启”等说明诱导反复授权，同时用“启用 Chrome 更新服务”常驻通知伪装。用户拒绝后回到桌面，应用保持驻留并安静降级，未见强制弹窗或崩溃。",
  "observed_lure_rhetoric_zh": [
    "英语 -> “HookAPP/启用 Chrome 更新服务”（通知横幅，贯穿无障碍列表与服务详情页）：以更新 Chrome 服务为名掩盖 Hook 无障碍服务。",
    "英语 -> “若无障碍权限已开启，请先关闭再重新开启。”（HookAPPService 服务详情页）：诱导用户反复切换以激活无障碍权限。",
    "英语 -> “使用 HookAPPService”（服务详情页）：直接引导开启该无障碍服务，弱化权限风险。"
  ],
  "frame_captions_zh": {
    "step_01": "系统无障碍设置列表，HookAPPService 显示关闭；通知冒充“启用 Chrome 更新服务”，探针命中后自动终止。",
    "post_jump_0.8s": "跳转后0.8秒仍在无障碍设置页，界面文本为空；应用通知“HookAPP/启用Chrome更新服务”持续显示，未见悬浮遮罩。",
    "post_jump_2.0s": "跳转后2.0秒仍停留无障碍设置页，无可见文本；伪装“启用Chrome更新服务”的通知横幅持续驻留，遮罩数为0。",
    "detail_1_service_detail_page": "进入 HookAPPService 服务详情，显示“使用 HookAPPService”开关与快捷方式；提示先关闭再开启无障碍权限，通知仍在。",
    "detail_2_system_warning_dialog": "系统警告弹窗环节并选择拒绝，页面仍为 HookAPPService 详情；可见“关闭再开启”提示，遮罩为0，弹窗未以悬浮层出现。",
    "refusal_2.0s": "拒绝后2秒回到桌面，显示应用列表、日期及 Messages/Chrome/Search 图标；应用通知仍驻留，无崩溃或强制跳转，呈安静降级。",
    "refusal_10.5s": "拒绝后10.5秒仍停在桌面，图标与通知状态不变；未见二次弹窗或强制跳转，应用维持驻留与降级行为。"
