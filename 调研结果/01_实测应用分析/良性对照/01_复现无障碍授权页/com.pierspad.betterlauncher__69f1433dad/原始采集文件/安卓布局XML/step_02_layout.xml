lse" password="false" selected="false" bounds="[94,337][986,1716]"><node index="0" text="BetterLauncher uses the Android AccessibilityService API for optional double-tap screen locking and app limits you configure.&#10;&#10;It accesses foreground app package names and window-change events to detect when a limited app opens or closes, and clicked view information (view type and accessibility label) to recognise the screen-lock gesture. When a selected app is in cooldown, it returns to the home screen and displays the remaining cooldown. App-limit settings and cooldown timestamps are stored only on your device.&#10;&#10;Accessibility data is processed on your device and is not sent to servers or shared with third parties. You can decline and continue using the launcher without these features, or disable the service at any time in Android Accessibility settings.&#10;&#10;Optional Xiaomi gestures use this same service to detect edge swipes and perform Back, Home and Recents. Unused edge touches are replayed locally. No additional accessibility service is required." resource-id="" class="android.widget.TextView" package="com.pierspad.betterlauncher" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,337][986,1716]" /></node><node index="2" text="I agree — open settings" resource-id="com.pierspad.betterlauncher:id/consentAccept" class="android.widget.TextView" package="com.pierspad.betterlauncher" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,1749][986,1894]" /><node index="3" text="No thanks" resource-id="com.pierspad.betterlauncher:id/consentDecline" class="android.widget.TextView" package="com.pierspad.betterlauncher" content-desc="" checkable="false" checked="fal