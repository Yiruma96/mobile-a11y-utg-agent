                            {
                              "attributes": {
                                "accessibilityId": "1009",
                                "id": "",
                                "text": "Buddy uses Android's accessibility service to do what you ask in other apps: it reads what's on the screen and taps, types and scrolls for you. It also shows the floating bubble.",
                                "key": "",
                                "description": "",
                                "type": "Text",
                                "bounds": "[55,957][1025,1180]",
                                "enabled": "true",
