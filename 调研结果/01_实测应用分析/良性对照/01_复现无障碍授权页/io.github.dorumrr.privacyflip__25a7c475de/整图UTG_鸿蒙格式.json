  "refusal_outcome_refined": "TRAPPED_ON_LURE_SCREEN",
  "app_chain_summary_zh": "应用入口为主界面，先以系统要求、Root授权和电池优化提示铺垫，再滚动展示锁屏/解锁隐私开关，最终用“锁屏检测（实验）”引导开启无障碍服务并弹出系统“完全控制”警告；选择拒绝后返回主界面且无退出或降级路径，轨迹判定为困在诱导页。",
  "observed_lure_rhetoric_zh": [
    "英文 -> “系统要求：隐私控制功能所需；特权访问；Root可用”，但提示无法确认Root，需打开Magisk允许后点“再次检查”（Step 1主界面）",
    "英文 -> “Privacy Flip无法执行：Root已配置但未获授权，锁屏/解锁动作被跳过，打开应用授权”（Step 1-6通知横幅）",
    "英文 -> “禁用电池优化以保证后台可靠运行”（Step 1主界面）",
    "英文 -> “锁屏检测（实验）：启用无障碍服务作为额外锁屏/解锁信号”（Step 5-6主界面卡片）",
    "英文 -> “本服务不读取屏幕内容或密码”，仅感知锁屏出现/消失（服务详情页）",
    "英文 -> “允许Privacy Flip获得完全控制？可查看并控制屏幕、读取所有内容、覆盖其他应用、跟踪交互并代操作”（系统警告弹窗）"
  ],
  "frame_captions_zh": {
    "step_01": "主界面系统要求页：提示Root可用但未授权，需打开Magisk后重查；电池优化已开启；顶部两条无法执行通知常驻，本次下滑寻找锁屏检测。",
    "step_02": "主界面隐私开关页：列出Wi-Fi、蓝牙、移动数据、定位、NFC及锁屏关闭/解锁开启选项；两条无法执行通知仍在，继续下滑。",
    "step_03": "主界面继续下滑：显示相机/麦克风及飞行模式、省电等扩展锁屏开关；提示Android版本不支持摄像头/麦克风切换，通知仍常驻。",
    "step_04": "主界面延时与调试页：显示应用豁免、锁屏后10秒/解锁后1秒延时、调试通知与日志开关；两条无法执行通知仍在，下滑露出无障碍状态。",
    "step_05": "主界面锁屏检测（实验）卡片：说明用无障碍服务作额外锁屏/解锁信号；点击未勾选开关以触发无障碍流程，通知仍常驻。",
    "step_06": "同一卡片：开关已开启，状态提示需在系统无障碍设置中启用；点击“打开无障碍设置”跳转系统页，两条无法执行通知仍常驻。",
    "step_07": "系统无障碍列表页：显示“Privacy Flip - Lock Screen Detection”为关闭；采集到无障碍设置钩子与探针后自动终止，应用通知仍在。",
    "post_jump_0.8s": "跳转后0.8秒探针：仍停留在系统无障碍列表页，无弹窗或遮罩，应用两条无法执行通知继续显示。",
    "post_jump_2.0s": "跳转后2.0秒探针：页面未变化，无遮罩或新弹窗，通知栏仍挂两条Privacy Flip无法执行提示。",
    "detail_1_service_detail_page": "服务详情页：说明无障碍仅感知锁屏出现/消失作额外信号，不读取屏幕内容或密码；服务当前关闭，需点“使用”进入系统授权。",
    "detail_2_system_warning_dialog": "系统授权警告弹窗：称该服务将获得完全控制，可查看屏幕内容、覆盖其他应用并代操作；底部允许/拒绝，本步选择拒绝。",
    "refusal_2.0s": "拒权后2秒返回主界面：仍停在延时/调试区域，无退出或降级路径；两条无法执行通知仍常驻，轨迹标记为困在诱导页。",
    "refusal_10.5s": "拒权后10.5秒：主界面未变化，仍显示延时/调试项且通知常驻；无取消或关闭诱导卡片路径，继续处于困在诱导页状态。"
  }
