  "app_chain_summary_zh": "主页面以“ATIVAR”按钮诱导进入教程弹窗，声称必须开启CleanDroid无障碍服务并跳转系统设置；在服务详情页与系统高危警告中继续施压，用户拒绝后应用反复重启同一诱导弹窗。",
  "observed_lure_rhetoric_zh": [
    "葡萄牙语“ATIVAR” -> “激活”按钮，作为入口诱导点击（主页面）",
    "葡萄牙语“VOCÊ PRECISA ATIVAR O RECURSO PARA UTILIZAR O CLEAN DROID...” -> “您必须激活该功能才能使用CleanDroid；请激活以下权限；如遇困难可联系支持；设置>无障碍>CleanDroid”（教程弹窗）",
    "葡萄牙语“Ativando o recurso você tem ativação do seu recurso...” -> “激活此功能即可启用；如有疑问联系支持；官方网络应用；需要权限才能运行”（服务详情页）",
    "英语“Allow CleanDroid to have full control of your device?” -> “允许CleanDroid完全控制您的设备？”（系统警告弹窗）"
  ],
  "frame_captions_zh": {
    "step_01": "主页面仅见葡萄牙语“ATIVAR”（激活）按钮，作为入口诱导点击；无通知/遮罩，点击后触发无障碍授权引导。",
    "step_02": "教程弹窗称必须激活CleanDroid功能，否则无法使用，并指引到设置>无障碍>CleanDroid；点“OK”跳系统无障碍页。",
    "step_03": "系统无障碍列表显示CleanDroid为Off，页面有下载应用等项；探针在此捕获无障碍钩子后自动终止，无通知/遮罩。",
    "post_jump_0.8s": "跳转后0.8秒探针：仍停留系统无障碍设置页，无通知横幅、无遮罩，未出现额外诱导界面。",
    "post_jump_2.0s": "跳转后2.0秒探针：系统无障碍页保持静止，遮罩数0、通知为空，未见自动点击或浮层。",
    "detail_1_service_detail_page": "服务详情页显示“Use CleanDroid”开关与快捷键选项；葡语说明称激活后可用、需权限运行，属官方应用，并引导开启。",
    "detail_2_system_warning_dialog": "系统高危警告要求允许CleanDroid完全控制设备，可读屏、显示悬浮层并代操作；含Allow/Deny，点Deny拒权。",
    "refusal_2.0s": "拒权返回2秒后，应用重新弹出同一葡语教程弹窗，反复要求激活无障碍权限；无通知/遮罩，属拒权后重试诱导。",
    "refusal_10.5s": "拒权返回10.5秒后教程弹窗仍持续存在，重复“必须激活”话术并仅给OK，形成循环施压，未新增通知/遮罩。"
  }
