  "app_chain_summary_zh": "应用先通过系统角色对话框被设为默认主屏，进入 Scratchpad 桌面后长按打开设置，连续下滑浏览桌面、外观与便签参数，最终点击“双击锁屏”实验开关。整体为合规的极简桌面配置流程，全程未见诱导话术、通知横幅或遮罩。",
  "observed_lure_rhetoric_zh": [],
  "frame_captions_zh": {
    "step_01": "系统默认主屏确认页，询问是否将 Scratchpad Launcher 设为默认；本步选中 Scratchpad 单选钮，未确认，无通知或遮罩。",
    "step_02": "同一系统角色页，Scratchpad 下显示“无需权限”；本步点击“设为默认”确认主屏，随后进入桌面，无横幅或遮罩。",
    "step_03": "Scratchpad 桌面主页：便签区空、时钟 4:32、周三 25 日 100%、底部 App 与手势提示；本步长按便签区打开设置。",
    "step_04": "桌面设置页：含更换默认启动器、隐藏应用、主屏应用数 3、小部件关、显示日期时间开、时钟置顶、图标左对齐；本步下滑。",
    "step_05": "设置续页：小部件关、日期时间开、时钟置顶、对齐左、下方间距 56dp、应用图标、表情分类、最近应用、屏幕时间、外观；继续下滑。",
    "step_06": "外观设置页：自动弹键盘、通知栏、深色主题、壁纸变暗 0%、文字默认/1.0、应用间距与文字大小、时钟日期外观；本步下滑。",
    "step_07": "便签外观页：字体 Sans、链接色 #4A90E2、格式工具栏、文字 1.0/行高 1.3、同步文件夹、备份恢复；本步下滑至手势区。",
    "step_08": "手势设置页：左滑相机、右滑电话、双击锁屏（实验性）、主屏列数 2；本步点击未勾选开关，拟启用双击锁屏。"
  }
