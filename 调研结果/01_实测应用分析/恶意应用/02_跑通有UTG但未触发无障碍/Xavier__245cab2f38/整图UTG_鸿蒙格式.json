  "app_chain_summary_zh": "链路从系统权限审查页请求文件媒体、联系人、电话、相机并点“继续”放行，进入清理主界面后以手机加速、垃圾清理、隐私风险和通知便捷话术连续引流。清理完成页再静默跳转至 AccessTip、进程管理及广告接收器组件，本轨迹未测试拒权结果。",
  "observed_lure_rhetoric_zh": [
    "英文 -> “选择允许 Master Cleanner 访问什么”，并列文件媒体、联系人、电话、相机权限（Step 1 权限审查页，含取消/继续）",
    "英文 -> “此应用为旧版 Android 构建，可能无法正常运行，请检查更新或联系开发者”（Step 2 兼容性警告，仅 OK）",
    "英文 -> “你的手机已加速”“0 M”“-450 MB/1.16 GB”（Step 4 加速结果页，制造已优化/释放空间效果）",
    "英文 -> “存在隐私问题的应用”“开启 AppLock 保护隐私”“立即前往”（Step 4、Step 6-8 隐私风险引流）",
    "英文 -> “开启通知，更方便管理手机”（Step 4、Step 6-8 通知开关诱导）",
    "英文 -> “扫描中…”“点击清理”（Step 4-5 按钮诱导，推动进入清理流程）",
    "英文 -> “已清理 1.59M 垃圾”“加速你的手机”（Step 6-8 清理完成页，夸大清理效果）",
    "英文 -> “手机加速”“垃圾清理”“应用锁”“清理”等功能入口（Step 3 首页，以工具名义吸引点击）"
  ],
  "frame_captions_zh": {
    "step_01": "系统权限审查页，英文要求选择允许 Master Cleanner 访问文件媒体、联系人、电话和相机；本步点“继续”放行，页面有取消键。",
    "step_02": "应用弹出旧版 Android 兼容警告，英文称可能无法正常运行、建议检查更新；本步点“OK”关闭警告以进入主界面，仅有确认键。",
    "step_03": "清理应用首页，展示内存、CPU温度及 Phone Boost、Junk Clean、App Lock 等入口；本步点击“手机加速”进入进程管理页。",
    "step_04": "手机加速结果页，英文称“你的手机已加速”并显示释放空间、隐私风险与通知开关诱导；本步点击“扫描中…”加速按钮。",
    "step_05": "垃圾清理结果页，英文显示扫描完成、可清理 1.59M 及缓存/缩略图/APK 分类；本步点“点击清理”触发后续组件跳转。",
    "step_06": "清理完成页，英文称“已清理1.59M垃圾/加速手机”，并含隐私、通知引流；本步静态回退跳转 AccessTipActivity。",
    "step_07": "仍为清理完成页，重复“已清理1.59M垃圾/加速手机”及隐私、通知引流；本步静态回退跳转 ProcessManagerActivity。",
    "step_08": "仍为清理完成页，重复清理/加速话术及隐私、通知引流；本步静态回退跳转广告接收器 PackageAddReceiver。"
  }
