                                        "hashcode": "67a349e7b54d",
                                        "hint": ""
                                      },
                                      "children": []
                                    },
                                    {
                                      "attributes": {
                                        "accessibilityId": "1010",
                                        "id": "",
                                        "text": "Circle to Share uses Android's Accessibility API (AccessibilityService) to capture your screen when you ask it to: from the Quick Settings tile, the floating button, or as a fallback for the assistant gesture. It is not an accessibility tool. Nothing it accesses is collected by, sent to, or shared with the developer or anyone else.",
                                        "key": "",
                                        "description": "",
                                        "type": "Text",
                                        "bounds": "[66,358][1014,702]",
                                        "enabled": "true",
                                        "focused": "false",
                                        "selected": "false",
                                        "clickable": "false",
                                        "longClickable": "false",
                                        "scrollable": "false",
                                        "checkable": "false",
                                        "checked": "false",
                                        "hostWindowId": "1",
                                        "displayId": "0",
                                        "origBounds": "[66,358][1014,702]",
                                        "zIndex": "0",
                                        "opacity": "1.0",
                                        "backgroundColor": "",
                                        "backgroundImage": "",
                                        "blur": "0.0",
                                        "hitTestBehavior": "Default",
                                        "clip": "false",
                                        "originalText": "Circle to Share uses Android's Accessibility API (AccessibilityService) to capture your screen when you ask it to: from the Quick Settings tile, the floating button, or as a fallback for the assistant gesture. It is not an accessibility tool. Nothing it accesses is collected by, sent to, or shared with the developer or anyone else.",
                                        "hierarchy": "ROOT,0,0,0,0,0,0,0,1",
                                        "visible": "true",
                                        "hashcode": "3dac8449582b",
                                        "hint": ""
                                      },
                                      "children": []
                                    },
                                    {
                                      "attributes": {
                                        "accessibilityId": "1011",
                                        "id": "",
                                        "text": "What it accesses",
                                        "key": "",
                                        "description": "",
                                        "type": "Text",
                                        "bounds": "[66,768][423,831]",
                                        "enabled": "true",
                                        "focused": "false",
                                        "selected": "false",
                                        "clickable": "false",
                                        "longClickable": "false",
                                        "scrollable": "false",
                                        "checkable": "false",
                                        "checked": "false",
                                        "hostWindowId": "1",
                                        "displayId": "0",
                                        "origBounds": "[66,768][423,831]",
                                        "zIndex": "0",
                                        "opacity": "1.0",
                                        "backgroundColor": "",
                                        "backgroundImage": "",
                                        "blur": "0.0",
                                        "hitTestBehavior": "Default",
                                        "clip": "false",
                                        "originalText": "What it accesses",
                                        "hierarchy": "ROOT,0,0,0,0,0,0,0,2",
                                        "visible": "true",
                                        "hashcode": "f6a7a0a03878",
                                        "hint": ""
                                      },
                                      "children": []
                                    },
                                    {
                                      "attributes": {
                                        "accessibilityId": "1012",
                                        "id": "",
                                        "text": "• A screenshot of your screen at the moment you trigger a capture.\n\n• The positions and sizes of the elements on screen (not their text or content) at that same moment, and only while \"Snap to screen content\" is switched on.\n\n• Notices from the system that a window has opened or changed, with the window's title and the app it belongs to, and the positions of system windows to recognize the lock screen, the power menu and the notification shade, so the floating button and the crop tool get out of their way.",
                                        "key": "",
                                        "description": "",
                                        "type": "Text",
                                        "bounds": "[66,842][1014,1447]",
                                        "enabled": "true",
                                        "focused": "false",
                                        "selected": "false",
                                        "clickable": "false",
                                        "longClickable": "false",
                                        "scrollable": "false",
                                        "checkable": "false",
                                        "checked": "false",
                                        "hostWindowId": "1",
                                        "displayId": "0",
                                        "origBounds": "[66,842][1014,1447]",
                                        "zIndex": "0",
                                        "opacity": "1.0",
                                        "backgroundColor": "",
                                        "backgroundImage": "",
                                        "blur": "0.0",
                                        "hitTestBehavior": "Default",
                                        "clip": "false",
                                        "originalText": "• A screenshot of your screen at the moment you trigger a capture.\n\n• The positions and sizes of the elements on screen (not their text or content) at that same moment, and only while \"Snap to screen content\" is switched on.\n\n• Notices from the system that a window has opened or changed, with the window's title and the app it belongs to, and the positions of system windows to recognize the lock screen, the power menu and the notification shade, so the floating button and the crop tool get out of their way.",
                                        "hierarchy": "ROOT,0,0,0,0,0,0,0,3",
                                        "visible": "true",
                                        "hashcode": "d0fc2144ee8e",
                                        "hint": ""
                                      },
                                      "children": []
                                    },
                                    {
                                      "attributes": {
                                        "accessibilityId": "1013",
                                        "id": "",
                                        "text": "How it is used",
                                        "key": "",
                                        "description": "",
                                        "type": "Text",
                                        "bounds": "[66,1513][363,1576]",
                                        "enabled": "true",
                                        "focused": "false",
                                        "selected": "false",
                                        "clickable": "false",
                                        "longClickable": "false",
                                        "scrollable": "false",
                                        "checkable": "false",
                                        "checked": "false",
                                        "hostWindowId": "1",
                                        "displayId": "0",
                                        "origBounds": "[66,1513][363,1576]",
                                        "zIndex": "0",
                                        "opacity": "1.0",
                                        "backgroundColor": "",
                                        "backgroundImage": "",
                                        "blur": "0.0",
                                        "hitTestBehavior": "Default",
                                        "clip": "false",
                                        "originalText": "How it is used",
                                        "hierarchy": "ROOT,0,0,0,0,0,0,0,4",
                                        "visible": "true",
                                        "hashcode": "8763471537d6",
                                        "hint": ""
                                      },
                                      "children": []
                                    },
                                    {
                                      "attributes": {
                                        "accessibilityId": "1014",
                                        "id": "",
                                        "text": "• Everything is processed on this device, in memory, to show you the crop tool.\n\n• The part you share or copy is written to the app's private cache so the receiving app can read it. Files older than an hour are deleted the next time you capture.\n\n• An image leaves Circle to Share only when you tap Share or Copy, and only to the app you choose, or when you tap Save, which puts it in your gallery (below Screenshots). The app has no internet permission.\n\n• The service never taps, types or changes settings for you. Its only two actions are (1) closing the notification shade when you use the Quick Settings tile; (2) simulating a swipe gesture when using the (experimental) scrollshot feature. For per-app settings, the app requests the installed app list when that submenu is opened.",
                                        "key": "",
                                        "description": "",
                                        "type": "Text",
                                        "bounds": "[66,1587][1014,1947]",
                                        "enabled": "true",
                                        "focused": "false",
                                        "selected": "false",
                                        "clickable": "false",
                                        "longClickable": "false",
                                        "scrollable": "false",
                                        "checkable": "false",
                                        "checked": "false",
                                        "hostWindowId": "1",
                                        "displayId": "0",
                                        "origBounds": "[66,1587][1014,1947]",
                                        "zIndex": "0",
                                        "opacity": "1.0",
                                        "backgroundColor": "",
                                        "backgroundImage": "",
                                        "blur": "0.0",
                                        "hitTestBehavior": "Default",
                                        "clip": "false",
                                        "originalText": "• Everything is processed on this device, in memory, to show you the crop tool.\n\n• The part you share or copy is written to the app's private cache so the receiving app can read it. Files older than an hour are deleted the next time you capture.\n\n• An image leaves Circle to Share only when you tap Share or Copy, and only to the app you choose, or when you tap Save, which puts it in your gallery (below Screenshots). The app has no internet permission.\n\n• The service never taps, types or changes settings for you. Its only two actions are (1) closing the notification shade when you use the Quick Settings tile; (2) simulating a swipe gesture when using the (experimental) scrollshot feature. For per-app settings, the app requests the installed app list when that submenu is opened.",
                                        "hierarchy": "ROOT,0,0,0,0,0,0,0,5",
                                        "visible": "true",
