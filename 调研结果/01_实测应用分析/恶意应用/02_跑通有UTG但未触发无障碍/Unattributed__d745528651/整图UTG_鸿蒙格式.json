  "app_chain_summary_zh": "应用以“系统更新”包名 com.sec.android.app.sysupdate 和 LauncherAlias 入口伪装系统组件，首屏为四位 PIN 门禁；连续输入 1234 并点 OK 后，探针跳转 .a.M、.AliasSettings、.AliasChrome 均未展示真实设置/授权页，仍停留于同一 PIN 键盘，具有别名规避与门禁诱导特征，授权/拒权未测试。",
  "observed_lure_rhetoric_zh": [
    "英文 -> 你的数据未备份（各步骤 GMS 通知横幅）",
    "英文 -> 立即添加备份账户（各步骤 GMS 通知横幅）"
  ],
  "frame_captions_zh": {
    "step_01": "首屏为四位PIN门禁键盘，含字母A/B/C与数字键；顶部1个圆点，无取消键；点击“1”，通知横幅称数据未备份。",
    "step_02": "PIN键盘页，顶部进度为2个圆点；本步点击“2”，无取消或返回入口；GMS通知仍称数据未备份、建议添加备份账户。",
    "step_03": "PIN键盘页，顶部进度为3个圆点；本步点击“3”，界面无取消键；通知横幅持续显示“数据未备份，立即添加备份账户”。",
    "step_04": "PIN键盘页，顶部进度为4个圆点；本步点击“4”完成四位PIN；界面仍无取消/返回；通知横幅提示数据未备份。",
    "step_05": "PIN键盘页显示4个圆点，本步点击勾选OK确认PIN；未进入真实系统设置，仍为门禁页；通知横幅称数据未备份。",
    "step_06": "静态跳转探针指向.a.M，但界面仍为同一PIN键盘，数字与字母键未变；无新页面内容，通知横幅仍提示数据未备份。",
    "step_07": "静态跳转探针指向.AliasSettings，界面仍停留在PIN键盘，无设置项或授权弹窗；通知横幅继续称数据未备份。",
    "step_08": "静态跳转探针指向.AliasChrome，仍显示PIN键盘且无新界面；未见授权/拒权结果；通知横幅称数据未备份。"
  }
