  "app_chain_summary_zh": "应用以五步引导设置启动，先引导将自身设为默认桌面，再进入主题、联系人、消息等设置；仅触发系统默认桌面角色授权，未出现通知横幅或悬浮遮罩，话术偏功能说明。",
  "observed_lure_rhetoric_zh": [
    "英文 -> “MinkLauncher 旨在替换当前主屏幕”（Step1/2 默认桌面页）",
    "英文 -> “当 Android 显示主屏幕应用列表时选择 Mink Launcher”（Step1/2 默认桌面页）",
    "英文 -> 系统询问是否将 MinkLauncher 设为默认主屏幕应用（Step3/4 系统角色页）",
    "英文 -> “无需权限”（Step4 系统角色页）",
    "英文 -> “MinkLauncher 已是你的默认主屏幕应用”（Step5 默认桌面页）",
    "英文 -> “选择完整主题，或在上方更改壁纸来源”（Step6 主题页）",
    "英文 -> “通过@发消息、#打电话联系亲友，无需翻找应用；显示星标联系人并匹配姓名”（Step7 联系人页）",
    "英文 -> “输入@选择常用消息应用，Mink 准备消息；启用 Mink 助理可跳过草稿自动发送”（Step8 消息页）"
  ],
  "frame_captions_zh": {
    "step_01": "第1/5步默认桌面引导页，称将替换当前主屏幕；点击Next但页面未前进，无通知/遮罩。",
    "step_02": "同一默认桌面引导页，探针改点“Default home app”区域以触发系统角色选择；仍无通知或遮罩。",
    "step_03": "跳转系统角色请求页，询问是否将MinkLauncher设为默认主屏幕并列出Pixel Launcher；探针点选前者单选项。",
    "step_04": "系统角色请求页出现“无需权限”说明，探针点击“Set as default”确认默认主屏幕；无通知/遮罩。",
    "step_05": "返回应用默认桌面页1/5，显示已授权“Granted”并可管理；点击Next进入下一步，无通知/遮罩。",
    "step_06": "进入2/5主题页，提供Mink Theme及Theme 1-7并标记已选；探针点底部继续进入下一步。",
    "step_07": "3/5联系人页，说明@发消息、#打电话并请求联系人权限；探针跳过授权点Next继续，无通知/遮罩。",
    "step_08": "4/5消息页，说明@选择消息应用及Mink助理自动发送增强体验；探针点Next完成本步，无通知/遮罩。"
  }
