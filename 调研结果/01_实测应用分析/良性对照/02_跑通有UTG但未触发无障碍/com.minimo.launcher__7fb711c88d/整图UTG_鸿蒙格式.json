  "app_chain_summary_zh": "该应用为极简桌面/双击锁屏类启动器：从欢迎页进入收藏应用选择，跳过默认桌面设置，长按主屏进入设置并探索自定义项；全程无强制授权、通知横幅或遮罩，未见明显诱导话术。",
  "observed_lure_rhetoric_zh": [
    "英文 -> “无干扰的主屏幕”（步骤1欢迎页）",
    "英文 -> “至少添加1个才能继续”（步骤2收藏应用页）",
    "英文 -> “选择Minimo作为你的默认桌面”（步骤4默认桌面引导页）",
    "英文 -> “安装图标包应用后可在此选择，未匹配图标保持默认”（步骤7自定义页）",
    "英文 -> “成为支持者”（步骤6/8设置菜单）"
  ],
  "frame_captions_zh": {
    "step_01": "启动欢迎页，英文意为“极简启动器/无干扰主屏/开始使用”；点Get Started进入引导，无通知遮罩。",
    "step_02": "收藏应用选择页，列出日历、相机等应用并提示“至少添加1个才能继续”；点击日历开关，未见通知或遮罩。",
    "step_03": "同一收藏应用页，底部按钮变为“继续”；点击Continue完成选择并进入下一步，页面无通知横幅与遮罩。",
    "step_04": "默认桌面引导页，英文意为“选择Minimo为默认桌面”，提供设置默认与跳过；点击Skip拒绝设置，无通知遮罩。",
    "step_05": "极简主屏仅显示日历标签；长按空白处以打开桌面选项/设置，当前页无通知横幅或浮层遮罩。",
    "step_06": "桌面设置菜单含收藏/隐藏应用、自定义、默认桌面、关于、支持作者等；点Customization，无通知遮罩。",
    "step_07": "自定义页显示方向、图标包、字体、主题及壁纸开关，提示可装图标包；未见双击锁屏项，点返回，无通知遮罩。",
    "step_08": "返回设置菜单后再次点击Customization，拟下滑查找“双击锁屏”开关；本页无通知横幅与遮罩。"
  }
}