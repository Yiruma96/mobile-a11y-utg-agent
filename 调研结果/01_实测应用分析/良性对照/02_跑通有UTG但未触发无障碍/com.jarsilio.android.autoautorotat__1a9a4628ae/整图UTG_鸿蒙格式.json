  "app_chain_summary_zh": "应用启动后停留在英文 AppIntro 的“Usage Access”引导页，以识别前台应用为由要求授予使用情况访问；NEXT 被权限门控，多次点击/滑动无效，点击 REQUEST PERMISSION 跳转系统设置并开启后返回。全程未见通知横幅或遮罩，属系统权限引导链路。",
  "observed_lure_rhetoric_zh": [
    "英文 -> “自动自动旋转需要‘使用情况访问’才能知道当前运行哪个应用”（Step1-5引导页）",
    "英文 -> “点击下方按钮后选择 Auto Auto-Rotate 并勾选‘允许使用情况访问’”（Step1-5引导页）",
    "英文 -> “请求权限”/“下一步”（Step1-5按钮）",
    "英文 -> “允许使用情况访问”，系统说明其可跟踪其他应用使用情况、运营商和语言等（Step7-8系统设置）"
  ],
  "frame_captions_zh": {
    "step_01": "英文引导页“Usage Access”说明需使用情况访问以识别当前应用；点击NEXT未前进，页面仍停留本页，无通知/遮罩。",
    "step_02": "同一英文引导页，仍要求授予使用情况访问；左滑ViewPager试图前进但未见切换，页面保持原样，无通知/遮罩。",
    "step_03": "仍是“Usage Access”引导页，说明需权限才能识别当前应用；再次指定坐标左滑仍未翻页，无通知/遮罩。",
    "step_04": "页面仍显示使用情况访问说明与REQUEST PERMISSION；点击右上箭头字形未前进，无通知/遮罩。",
    "step_05": "因NEXT被权限门控，点击REQUEST PERMISSION跳转系统使用情况访问设置；本页为权限入口，无通知/遮罩。",
    "step_06": "系统“Usage access”列表显示Auto Auto-Rotate为Not allowed；点击该应用进入授权详情，无通知/遮罩。",
    "step_07": "系统授权详情页，含Permit usage access开关及跟踪说明；点击未选中的开关以开启，无通知/遮罩。",
    "step_08": "同一授权详情页，开关已开启后点击Back返回应用引导流；页面为系统设置，无通知/遮罩。"
  }
