  "app_chain_summary_zh": "应用以“TypeAssist AI 输入增强”欢迎页引导用户进入权限页，将无障碍服务标为必需并跳转系统设置；在系统“完全控制设备”警告处拒绝后，应用仍反复回到权限诱导页并卡住，形成 TRAPPED_ON_LURE_SCREEN。",
  "observed_lure_rhetoric_zh": [
    "英文 -> 在任何地方输入，添加触发词，让 AI 处理其余内容（欢迎页）",
    "英文 -> TypeAssist 在这些权限下效果最佳（权限页）",
    "英文 -> 读取并替换文本所必需（权限页）",
    "英文 -> 防止系统杀死应用（权限页）",
    "英文 -> 允许 TypeAssist AI 完全控制你的设备？（系统警告弹窗）",
    "英文 -> 完全控制适用于帮助无障碍需求的 app，但大多数应用不适用（系统警告弹窗）",
    "英文 -> 可读取屏幕上所有内容并在其他应用上显示内容（系统警告弹窗）",
    "英文 -> 可跟踪你与 app 或硬件传感器的交互，并代表你操作 app（系统警告弹窗）"
  ],
  "frame_captions_zh": {
    "step_01": "欢迎页展示 TypeAssist 与 AI is thinking，称可在任意处输入并由 AI 处理；点击 Next 进入引导，无通知/遮罩。",
    "step_02": "权限页将无障碍服务标为 REQUIRED，称用于读取替换文本，电池优化为稳定性推荐；点击无障碍服务卡，无通知/遮罩。",
    "step_03": "系统无障碍列表页显示 TypeAssist AI 为 Off；捕获无障碍设置 Hook 与探针后自动终止，无通知/遮罩，尚未开启服务。",
    "post_jump_0.8s": "跳转后 0.8 秒探针仍停留在系统无障碍设置页，界面无可读文本，overlays=0、无通知，未出现额外弹窗。",
    "post_jump_2.0s": "跳转后 2.0 秒探针仍在系统无障碍设置页，无新增文本与通知，overlays=0，状态未变化。",
    "detail_1_service_detail_page": "TypeAssist AI 服务详情页显示 Use TypeAssist AI 开关及快捷方式选项仍为 Off；仅检查详情，无通知/遮罩。",
    "detail_2_system_warning_dialog": "系统警告弹窗询问是否允许 TypeAssist AI 完全控制设备，列明可读屏、覆盖显示与代替操作；有 Allow/Deny，overlays=0。",
    "refusal_2.0s": "在警告弹窗拒绝/返回后 2 秒，应用回到权限页，仍将无障碍服务标为 REQUIRED 并卡住；无通知/遮罩，形成诱导页陷阱。",
    "refusal_10.5s": "拒权返回 10.5 秒后仍停留在同一权限诱导页，无障碍服务仍标 REQUIRED，无通知/遮罩，未提供继续退出路径。"
  }
