  "app_chain_summary_zh": "应用先诱导授予电话与短信权限，随后通过常驻土耳其语通知把用户拉回 WebView，反复指导在系统设置中为“Chrome”开启无障碍服务；用户返回拒绝后立即重弹同一诱导页，呈现 Coper 家族常见的无障碍滥用与持久化诱导特征。",
  "observed_lure_rhetoric_zh": [
    "英语 -> 允许 Chrome 拨打和管理电话（Step 1 系统权限弹窗）",
    "英语 -> 允许 Chrome 发送和查看短信（Step 2 系统权限弹窗）",
    "土耳其语 -> “启用服务”，通知正文为“Chrome”（Step 3/4/5 等常驻通知）",
    "英语 -> 启用无障碍服务；查找“Chrome”；打开开关；打开设置（Step 5 及拒权返回页）",
    "英语 -> 使用 Chrome / Chrome 快捷方式（服务详情页，伪装成 Chrome 服务）",
    "土耳其语 -> “启用无障碍服务”（服务详情页说明，含拼写 Servisileri）"
  ],
  "frame_captions_zh": {
    "step_01": "系统权限弹窗请求“允许 Chrome 拨打和管理电话”，点击 Allow 同意；未见通知或遮罩。",
    "step_02": "系统权限弹窗请求“允许 Chrome 发送和查看短信”，点击 Allow 同意；仍无通知与遮罩。",
    "step_03": "回到桌面启动器，顶部有本应用常驻通知“Servisi etkinleştirin/Chrome”（启用服务）；点击通知返回应用。",
    "step_04": "进入应用 WebView 页，未捕获文字；保留土耳其语“启用服务”通知，按坐标点击页面以打开系统设置。",
    "step_05": "应用内诱导页用英文指导：启用无障碍服务、查找 Chrome、打开开关；点击 Open Settings 跳系统设置。",
    "step_06": "跳至系统无障碍列表，DOWNLOADED APPS 下 Chrome 显示 Off；采集到设置钩子后终止，无通知或遮罩。",
    "post_jump_0.8s": "跳转后 0.8 秒探针：仍停留在无障碍设置页，无 UI 文本、无通知、遮罩数为 0，仅等待观察。",
