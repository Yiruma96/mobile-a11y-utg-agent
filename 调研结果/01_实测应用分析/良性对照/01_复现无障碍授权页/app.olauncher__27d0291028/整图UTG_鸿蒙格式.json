  "refusal_outcome_refined": "TRAPPED_ON_LURE_SCREEN",
  "app_chain_summary_zh": "应用先取消系统默认桌面设置，进入极简桌面并长按呼出设置；开启双击锁屏时以无障碍说明引导跳转系统授权，拒权后返回桌面反复显示「设为默认启动器」入口，形成被困诱导页。",
  "observed_lure_rhetoric_zh": [
    "英文 -> 中文：将 Olauncher 设为默认主屏幕应用？（系统角色页，提供取消/设为默认）",
    "英文 -> 中文：欢迎来到设置！如有问题，关于页面有答案。（欢迎弹窗，Okay 关闭）",
    "英文 -> 中文：请在设备设置中开启 Olauncher 无障碍服务以启用双击锁屏；该服务仅用于此功能，不收集或分享任何数据。（无障碍说明弹窗）",
    "英文 -> 中文：启用双击锁屏手势需要无障碍权限；Olauncher 经此服务获取的任何数据都不会离开你的设备。（服务详情页）",
    "英文 -> 中文：允许 Olauncher 完全控制你的设备？适合无障碍需求应用，不适合多数应用；可查看控制屏幕、跟踪交互并代为操作。（系统警告弹窗）",
    "英文 -> 中文：将 Olauncher 设为默认启动器（拒权返回桌面上的入口）"
  ],
  "frame_captions_zh": {
    "step_01": "系统默认主屏角色页，询问是否将 Olauncher 设为默认主屏；列出 Pixel Launcher，并提供取消与设为默认，本步点击取消。",
    "step_02": "Olauncher 主屏首次进入，显示时间日期、100% 电量及上滑应用/长按设置提示；本步长按空白处打开设置。",
    "step_03": "主屏弹出英文欢迎弹窗，称有疑问可看关于页，按钮 Okay；本步点击 Okay 关闭并露出设置页。",
    "step_04": "Olauncher 设置页上半部，含设为默认启动器、关于、主屏应用数、日期时间与外观；本步下滑寻找双击锁屏项。",
    "step_05": "设置页下半部外观与手势项，可见自动键盘、每日壁纸、通知栏、主题及 Off 开关；本步点击双击锁屏行的 Off。",
    "step_06": "手势说明弹窗称开启无障碍服务可启用双击锁屏，并称不收集共享数据；有 Enable 按钮，本步点击跳系统设置。",
    "step_07": "系统无障碍设置页，下载应用列表显示 Olauncher 为 Off，另有搜索、屏幕阅读器与显示项；采集 hook 后自动终止。",
    "post_jump_0.8s": "跳转后 0.8 秒探针，仍停留系统无障碍设置页，无通知横幅、无悬浮遮罩，页面文本暂未采集。",
    "post_jump_2.0s": "跳转后 2.0 秒探针，系统无障碍设置页保持稳定，仍无通知与遮罩，未出现覆盖层诱导。",
    "detail_1_service_detail_page": "Olauncher 无障碍服务详情页，含 Use Olauncher、Olauncher shortcut 为 Off 与隐私说明；称权限仅用于双击锁屏且数据不离设备。",
    "detail_2_system_warning_dialog": "系统全权控制警告弹窗，说明可查看控制屏幕、跟踪交互并代为操作，提供 Allow/Deny；本步检查后选择拒绝。",
    "refusal_2.0s": "拒绝无障碍权限后 2 秒返回 Olauncher 主屏，仅见时间日期与「设为默认启动器」入口，无取消关闭，形成被困诱导页。",
    "refusal_10.5s": "拒权返回 10.5 秒后仍停在 Olauncher 主屏，同样显示「设为默认启动器」入口，无退出或取消，持续被困。"
  }
}