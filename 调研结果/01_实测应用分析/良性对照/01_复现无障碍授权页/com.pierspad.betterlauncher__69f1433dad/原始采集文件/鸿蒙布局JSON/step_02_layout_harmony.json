                                            {
                                              "attributes": {
                                                "accessibilityId": "1012",
                                                "id": "",
                                                "text": "BetterLauncher uses the Android AccessibilityService API for optional double-tap screen locking and app limits you configure.\n\nIt accesses foreground app package names and window-change events to detect when a limited app opens or closes, and clicked view information (view type and accessibility label) to recognise the screen-lock gesture. When a selected app is in cooldown, it returns to the home screen and displays the remaining cooldown. App-limit settings and cooldown timestamps are stored only on your device.\n\nAccessibility data is processed on your device and is not sent to servers or shared with third parties. You can decline and continue using the launcher without these features, or disable the service at any time in Android Accessibility settings.\n\nOptional Xiaomi gestures use this same service to detect edge swipes and perform Back, Home and Recents. Unused edge touches are replayed locally. No additional accessibility service is required.",
                                                "key": "",
                                                "description": "",
                                                "type": "Text",
                                                "bounds": "[94,337][986,1716]",
                                                "enabled": "true",
                                                "focused": "false",
                                                "selected": "false",
                                                "clickable": "false",
                                                "longClickable": "false",
                                                "scrollable": "false",
                                                "checkable": "false",
                                                "checked": "false",
                                                "hostWindowId": "1",
                                                "displayId": "0",
                                                "origBounds": "[94,337][986,1716]",
                                                "zIndex": "0",
                                                "opacity": "1.0",
                                                "backgroundColor": "",
