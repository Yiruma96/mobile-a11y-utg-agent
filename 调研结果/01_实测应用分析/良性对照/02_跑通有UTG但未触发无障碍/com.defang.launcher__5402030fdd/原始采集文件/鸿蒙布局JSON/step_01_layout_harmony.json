                                    "checked": "false",
                                    "hostWindowId": "1",
                                    "displayId": "0",
                                    "origBounds": "[88,435][992,624]",
                                    "zIndex": "0",
                                    "opacity": "1.0",
                                    "backgroundColor": "",
                                    "backgroundImage": "",
                                    "blur": "0.0",
                                    "hitTestBehavior": "Default",
                                    "clip": "false",
                                    "originalText": "This is a speed bump. Not a wall.",
                                    "hierarchy": "ROOT,0,0,0,0,0,0,1",
                                    "visible": "true",
                                    "hashcode": "b5b1ef14b7ef",
                                    "hint": ""
                                  },
                                  "children": []
                                },
                                {
                                  "attributes": {
                                    "accessibilityId": "1012",
                                    "id": "",
                                    "text": "Some apps will block your phone completely. Some will go full grayscale through developer settings. This is not that. You can still open Instagram. You can still override the timer. Nothing here is impossible to bypass.\n\nThat is deliberate. A wall creates pressure. Pressure demands release. You've seen this: Instagram's own time limit ships with a \"15 more minutes\" button that you tap without thinking. The limit exists, but the exit is so frictionless that it trains you to ignore the limit, not respect it.\n\nThis app puts a speed bump in front of the reflex. It makes the unconscious open a conscious one. What you do after that is up to you.",
                                    "key": "",
                                    "description": "",
                                    "type": "Text",
                                    "bounds": "[88,690][992,1966]",
                                    "enabled": "true",
                                    "focused": "false",
                                    "selected": "false",
                                    "clickable": "false",
                                    "longClickable": "false",
                                    "scrollable": "false",
                                    "checkable": "false",
                                    "checked": "false",
                                    "hostWindowId": "1",
                                    "displayId": "0",
                                    "origBounds": "[88,690][992,1966]",
                                    "zIndex": "0",
                                    "opacity": "1.0",
                                    "backgroundColor": "",
                                    "backgroundImage": "",
                                    "blur": "0.0",
                                    "hitTestBehavior": "Default",
                                    "clip": "false",
                                    "originalText": "Some apps will block your phone completely. Some will go full grayscale through developer settings. This is not that. You can still open Instagram. You can still override the timer. Nothing here is impossible to bypass.\n\nThat is deliberate. A wall creates pressure. Pressure demands release. You've seen this: Instagram's own time limit ships with a \"15 more minutes\" button that you tap without thinking. The limit exists, but the exit is so frictionless that it trains you to ignore the limit, not respect it.\n\nThis app puts a speed bump in front of the reflex. It makes the unconscious open a conscious one. What you do after that is up to you.",
