                                {
                                  "attributes": {
                                    "accessibilityId": "1011",
                                    "id": "",
                                    "text": "This is a speed bump. Not a wall.",
                                    "key": "",
                                    "description": "",
                                    "type": "Text",
                                    "bounds": "[88,435][992,624]",
                                    "enabled": "true",
                                    "focused": "false",
                                    "selected": "false",
                                    "clickable": "false",
