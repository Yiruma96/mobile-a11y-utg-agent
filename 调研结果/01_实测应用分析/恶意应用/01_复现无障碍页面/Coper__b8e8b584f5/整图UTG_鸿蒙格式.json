  "app_chain_summary_zh": "com.upon.front 以“Chrome”名义先请求电话/短信权限，被拒后退回桌面并挂出“Servisi etkinleştirin/Chrome”通知，再用仿冒引导页诱导用户在系统无障碍设置中为 Chrome 开启无障碍服务；拒权返回后反复重弹同一引导和电话权限请求，具备 Coper 类无障碍滥用与循环诱导特征。",
  "observed_lure_rhetoric_zh": [
    "Servisi etkinleştirin（土耳其语） -> 启用服务（通知横幅，贯穿各页）",
    "Chrome（英语，用作服务名） -> 以“Chrome”名义伪装无障碍服务（通知与系统设置页）",
    "Enable Accessibility Service（英语） -> 启用无障碍服务（应用内引导页 step_04/detail_2/refusal）",
    "Find 'Chrome'（英语） -> 找到“Chrome”（应用内引导页）",
    "Set switch ON（英语） -> 打开开关（应用内引导页）",
    "Open Settings（英语） -> 打开设置（应用内引导页按钮）",
    "Erişebilirlik Servisileri Etkinleştirme（土耳其语） -> 启用无障碍服务（服务详情页 detail_1）",
    "Use Chrome（英语） -> 使用 Chrome（Chrome 无障碍服务详情页）"
  ],
  "frame_captions_zh": {
    "step_01": "权限控制器请求「允许 Chrome 拨打和管理电话？」，点 Deny 拒绝，未授予电话权限，应用继续。",
    "step_02": "权限页请求「允许 Chrome 发送和查看短信？」，点 Deny 拒绝；通知栏仍挂「启用服务/Chrome」诱导横幅。",
    "step_03": "应用退回桌面启动器，可见 Messages/Chrome 图标；通知栏仍留「启用服务/Chrome」横幅，点击坐标(270,130)。",
    "step_04": "仿冒引导页提示「启用无障碍服务：找到 Chrome 并打开开关」，点 Open Settings 跳系统无障碍设置；无遮罩。",
    "step_05": "系统无障碍列表显示下载应用 Chrome 为 Off；采集到设置 Hook 后自动终止，通知栏仍留「启用服务/Chrome」横幅。",
    "post_jump_0.8s": "跳转后 0.8 秒探针：仍停留无障碍设置页，UI 未取到文本、无遮罩；通知栏持续显示「启用服务/Chrome」。",
    "post_jump_2.0s": "跳转后 2.0 秒探针：仍为无障碍设置页，无遮罩、无新 UI 文本；通知栏持续显示「启用服务/Chrome」诱导横幅。",
    "detail_1_service_detail_page": "Chrome 无障碍服务详情页，含 Use Chrome、快捷键、音量键等选项及土耳其语「启用无障碍服务」标题；仅检查未操作。",
    "detail_2_system_warning_dialog": "实际回到应用内「启用无障碍服务」引导页，指示找到 Chrome 并打开开关；探针未见系统警告弹窗或遮罩。",
    "refusal_2.0s": "拒权返回 2 秒后，应用重新弹出同一「启用无障碍服务/找到 Chrome 开开关」引导页，形成反复诱导。",
    "refusal_10.5s": "拒权返回 10.5 秒后又弹回电话权限请求「允许 Chrome 拨打和管理电话？」，显示拒绝后仍循环诱导。"
  }
