  "app_chain_summary_zh": "应用先骗取VPN和未知来源安装权限，安装伪装成S.A.C ITAÚ的恶意包，再用“安装中/已验证”和三步教程诱导开启无障碍；拒权后反复重拉同一诱导页。",
  "observed_lure_rhetoric_zh": [
    "英语 -> “S.A.C ITAÚ 希望建立 VPN 连接以监控网络流量，仅信任来源时接受”（step_01 VPN授权弹窗）",
    "英语 -> “允许来自此来源”及未知应用风险警告（step_02/03 未知来源设置页）",
    "葡萄牙语/英语 -> “请稍候…/正在优化系统”“正在安装…”“✓ Google Play Protect 已验证”（step_05 恶意安装页）",
    "葡萄牙语 -> “此应用需要访问权限才能运行，请允许以继续”（step_06/refusal 无障碍引导页）",
    "英语/葡语 -> “点击继续 / 查找已下载应用 / 启用 S.A.C ITAÚ”及“CONTINUAR”（step_06/refusal 无障碍引导页）"
  ],
  "frame_captions_zh": {
    "step_01": "VPN授权弹窗：英文称S.A.C ITAÚ请求监控网络流量，仅信任时接受；点击OK授予VPN，顶部有Google备份通知。",
    "step_02": "未知来源设置页：显示S.A.C ITAÚ 1.0，英文警告未知应用风险；勾选“允许来自此来源”开关以放行安装，顶部备份通知。",
    "step_03": "同一未知来源页：开关已开启，英文风险提示仍在；点击左上返回恶意应用继续诱导，全程无遮罩，通知横幅保留。",
    "step_04": "系统安装确认页：英文“是否安装此应用？”，显示S.A.C ITAÚ；点击Install继续安装恶意载荷，通知横幅仍在。",
    "step_05": "恶意安装页：葡文“请稍候/优化系统”、英文“安装中”及“Play Protect已验证”伪装可信；等待后触发广播。",
    "step_06": "无障碍引导页：葡文称需访问权限，英文三步“继续/找应用/启用S.A.C ITAÚ”；点CONTINUAR后捕获钩子即终止。",
    "post_jump_0.8s": "跳后0.8秒探针：仍停在无障碍设置页，界面文本为空、遮罩0；S.A.C与Google备份通知仍在，无用户操作。",
    "post_jump_2.0s": "跳后2秒探针：无障碍设置页持续空白、无遮罩；恶意应用S.A.C与Google备份通知仍挂起，未见新弹窗。",
    "detail_1_service_detail_page": "无障碍设置详情页：显示DOWNLOADED APPS下S.A.C ITAÚ为Off，另有屏幕阅读/显示项；仅巡检未授权，通知仍在。",
    "detail_2_system_warning_dialog": "巡检时出现系统“深色主题”说明弹窗，含Got it；无权限授权动作，遮罩0，S.A.C与备份通知仍在。",
    "refusal_2.0s": "拒权后2秒：恶意应用重拉葡语“访问页”，称需访问权限才能继续，含三步教程与CONTINUAR；记录为重启诱导弹窗。",
    "refusal_10.5s": "拒权后10.5秒：同一葡语“访问页”与三步教程仍在，未见权限关闭/取消，动作仍记为重启诱导弹窗，通知横幅保留。"
  }
