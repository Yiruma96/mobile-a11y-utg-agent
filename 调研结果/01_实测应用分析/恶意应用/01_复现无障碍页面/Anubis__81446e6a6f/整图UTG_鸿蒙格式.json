  "observed_lure_rhetoric_zh": [
    "俄语 -> “继续”（第1步伪造TikTok页底部蓝色按钮）",
    "英语 -> “允许TikTok完全控制你的设备？”并说明可查看和控制屏幕、代你执行操作（系统无障碍授权警告弹窗）",
    "英语 -> “让应用始终在后台运行？”并称可能降低续航、稍后可在设置中更改（电池优化豁免请求页）",
    "英语 -> “你的数据未备份/立即添加备份账户”（贯穿各页的Google Play服务通知横幅）"
  ],
  "frame_captions_zh": {
    "step_01": "伪造TikTok主页，界面无可见文字；点击底部蓝色俄语“Продолжить（继续）”，顶部有数据未备份通知横幅，无遮罩。",
    "step_02": "跳转系统无障碍设置，列表显示已下载应用TikTok为“关闭”；采集到无障碍设置Hook后自动终止，顶部保留备份通知。",
    "post_jump_0.8s": "跳转后0.8秒探针仍停留在无障碍设置页，界面无新增文字、无遮罩，仅见数据未备份通知横幅。",
    "post_jump_2.0s": "跳转后2.0秒探针仍为无障碍设置页，无新增可见文本与遮罩，备份账户通知横幅持续显示。",
    "detail_1_service_detail_page": "进入TikTok无障碍服务详情页，显示“Use TikTok/使用TikTok”及快捷键等选项，说明为“未提供描述”；本步仅检查详情。",
    "detail_2_system_warning_dialog": "系统弹窗警告允许TikTok完全控制设备，称可读取屏幕内容、代你操作应用；提供允许/拒绝，本步仅检查未点选。",
    "refusal_2.0s": "拒权后返回，弹出后台运行请求：允许TikTok始终后台运行可能耗电，可选拒绝/允许；状态为优雅停留或降级。",
    "refusal_10.5s": "拒权后10.5秒仍停在后台运行请求页，话术称可能降低续航、稍后可改；拒绝/允许按钮仍在，未进一步跳转。"
